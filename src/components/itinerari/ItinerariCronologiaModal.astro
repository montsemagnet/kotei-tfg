---
import Text from "@/components/fundations/elements/Text.astro";
import ItinerariModalHeaderActions from "@/components/itinerari/ItinerariModalHeaderActions.astro";
import ItinerariVideoModal from "@/components/itinerari/ItinerariVideoModal.astro";
import { cronologiaVideoPerTitol, type CronologiaVideoLink } from "@/data/cronologia-videos";
import { withBase } from "@/utils/withBase";

export interface CronologiaItem {
  tipus: "periode" | "proces" | "producte";
  titol: string;
  text?: string;
  categoria?: string;
  videoPublicSrc?: string;
  videoAmbSo?: boolean;
}

interface Props {
  modalId: string;
  label: string;
  intro?: string;
  items: CronologiaItem[];
  iconSrc?: string;
  arrowSrc?: string;
}

const {
  modalId,
  label,
  intro,
  items,
  iconSrc = "/images/itineraris/sau-tavertet/icone-proces.png",
  arrowSrc = "/images/itineraris/sau-tavertet/fletxa.png",
} = Astro.props;

const titleId = `${modalId}-title`;
const iconUrl = withBase(iconSrc);
const arrowUrl = withBase(arrowSrc);
const panelCloseClass =
  "itinerari-dada-close rounded-full bg-base-200 dark:bg-base-800 px-4 py-2 text-sm text-base-900 dark:text-white hover:bg-base-300 dark:hover:bg-base-700";
const periodeLinkClass =
  "text-left cursor-pointer dark:text-accent-400 text-accent-700 font-medium tracking-tight underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[4px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors";
const paradaLinkClass =
  "text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors";
const procesLinkClass =
  "text-left cursor-pointer text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors leading-snug";

function resolveItemVideo(item: CronologiaItem): CronologiaVideoLink | undefined {
  const titol = item.titol.replace(/^[↓⬇]\s*/u, "").trim();
  const fromMap = cronologiaVideoPerTitol[titol];
  if (item.videoPublicSrc) {
    return {
      hideLabel: fromMap?.hideLabel,
      startUnmuted: fromMap?.startUnmuted,
      fit: fromMap?.fit,
      ...fromMap,
      src: item.videoPublicSrc,
      sound: item.videoAmbSo ?? fromMap?.sound ?? true,
    };
  }
  return fromMap;
}

function splitLinkPhrase(
  titol: string,
  phrase?: string,
): { before: string; phrase: string; after: string } | null {
  if (!phrase) return null;
  const index = titol.toLowerCase().indexOf(phrase.toLowerCase());
  if (index < 0) return null;
  return {
    before: titol.slice(0, index),
    phrase: titol.slice(index, index + phrase.length),
    after: titol.slice(index + phrase.length),
  };
}

function parseParadaTitle(titol: string): {
  codes: string[];
  separator: string;
  rest: string;
} | null {
  const match = titol.match(
    /^((?:A\d+|P\d+)(?:-(?:A\d+|P\d+))*)([-\s]+)(.*)$/,
  );
  if (!match) return null;
  const codes = match[1].split("-").filter((code) => /^(A|P)\d+$/.test(code));
  if (codes.length === 0) return null;
  return { codes, separator: match[2], rest: match[3] };
}

const resolvedItems = items.map((item, index) => ({
  item,
  index,
  video: resolveItemVideo(item),
}));
const videoItems = resolvedItems.filter(({ video }) => Boolean(video));
---

<dialog
  id={modalId}
  class="itinerari-dada-dialog fixed inset-0 z-[110] m-0 size-full max-h-none max-w-none border-0 bg-base-950/90 p-4 backdrop:bg-transparent open:flex open:items-start open:justify-center overflow-y-auto"
  aria-modal="true"
  aria-labelledby={titleId}
  data-focus-trap="true"
>
  <div
    class="itinerari-dada-panel relative my-8 w-full max-w-3xl rounded-lg bg-base-100 dark:bg-base-900 p-6 lg:p-10 shadow-xl"
    data-text-size-enabled="true"
    spellcheck="false"
  >
    <ItinerariModalHeaderActions closeClass={panelCloseClass} />

    <div class="itinerari-modal-text-content">
      <Text
        id={titleId}
        tag="h2"
        variant="displayMD"
        class="dark:text-white text-base-900 font-medium tracking-tighter mb-6 pr-52 leading-tight"
      >
        {label}
      </Text>

      {
        intro &&
          intro
            .split(/\n\s*\n/)
            .map((p) => p.trim())
            .filter(Boolean)
            .map((paragraph) => (
              <Text
                tag="p"
                variant="textBase"
                class="text-base-500 dark:text-base-400 mb-4 last:mb-8 leading-relaxed"
              >
                {paragraph}
              </Text>
            ))
      }

      <ol class="list-none p-0 m-0 flex flex-col">
        {
          resolvedItems.map(({ item, index, video }) => {
            const titol = item.titol.replace(/^[↓⬇]\s*/u, "").trim();
            const previous = index > 0 ? items[index - 1] : undefined;
            const showResultArrow =
              item.tipus === "producte" && previous?.tipus === "proces";
            const paradaTitle = parseParadaTitle(titol);

            if (item.tipus === "periode") {
              const videoModalId = video
                ? `${modalId}-video-${index}`
                : undefined;
              return (
                <li class="mt-8 first:mt-0 mb-4 border-t border-base-200 dark:border-base-800 pt-6">
                  {
                    videoModalId ? (
                      <Text
                        tag="h3"
                        variant="displaySM"
                        class="leading-tight"
                      >
                        <button
                          type="button"
                          data-cronologia-video-target={videoModalId}
                          class={periodeLinkClass}
                          aria-haspopup="dialog"
                          aria-label={`Obrir vídeo: ${titol}`}
                        >
                          {titol}
                        </button>
                      </Text>
                    ) : (
                      <Text
                        tag="h3"
                        variant="displaySM"
                        class="dark:text-white text-base-900 font-medium tracking-tight"
                      >
                        {titol}
                      </Text>
                    )
                  }
                  {
                    item.text && (
                      <Text
                        tag="p"
                        variant="textBase"
                        class="text-base-500 dark:text-base-400 mt-2 leading-relaxed"
                      >
                        {item.text}
                      </Text>
                    )
                  }
                </li>
              );
            }

            if (item.tipus === "proces") {
              const videoModalId = video
                ? `${modalId}-video-${index}`
                : undefined;
              const linked = videoModalId
                ? splitLinkPhrase(titol, video?.linkPhrase)
                : null;
              return (
                <li class="flex items-start gap-2 py-1.5">
                  <span
                    class="mt-0.5 size-5 shrink-0 bg-accent-700 dark:bg-accent-400"
                    style={`mask: url('${iconUrl}') center / contain no-repeat; -webkit-mask: url('${iconUrl}') center / contain no-repeat; mask-mode: alpha; -webkit-mask-source-type: alpha;`}
                    aria-hidden="true"
                  />
                  {
                    videoModalId ? (
                      linked ? (
                        <p class="text-base text-base-700 dark:text-base-200 leading-snug">
                          {linked.before}
                          <button
                            type="button"
                            data-cronologia-video-target={videoModalId}
                            class={`${procesLinkClass} inline`}
                            aria-haspopup="dialog"
                            aria-label={`Obrir vídeo: ${linked.phrase}`}
                          >
                            {linked.phrase}
                          </button>
                          {linked.after}
                        </p>
                      ) : (
                        <button
                          type="button"
                          data-cronologia-video-target={videoModalId}
                          class={procesLinkClass}
                          aria-haspopup="dialog"
                          aria-label={`Obrir vídeo: ${titol}`}
                        >
                          {titol}
                        </button>
                      )
                    ) : (
                      <Text
                        tag="p"
                        variant="textBase"
                        class="text-base-700 dark:text-base-200 leading-snug"
                      >
                        {titol}
                      </Text>
                    )
                  }
                </li>
              );
            }

            return (
              <>
                {
                  showResultArrow && (
                    <li class="flex justify-center py-2" aria-hidden="true">
                      <img
                        src={arrowUrl}
                        alt=""
                        class="h-8 w-auto sm:h-9"
                        width="36"
                        height="36"
                      />
                    </li>
                  )
                }
                <li class="grid grid-cols-1 sm:grid-cols-[minmax(11rem,1fr)_minmax(0,max-content)] gap-x-6 gap-y-1 items-baseline py-3 border-b border-base-200/80 dark:border-base-800/80">
                  <Text
                    tag="p"
                    variant="textBase"
                    class="dark:text-white text-base-900 font-semibold leading-snug"
                  >
                    {
                      paradaTitle ? (
                        <>
                          {paradaTitle.codes.map((code, codeIndex) => (
                            <>
                              {codeIndex > 0 ? "-" : ""}
                                <a
                                  href={withBase(`/parades/I1-${code}`)}
                                  class={paradaLinkClass}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  aria-label={`Obrir parada ${code} en una pestanya nova`}
                                >
                                {code}
                              </a>
                            </>
                          ))}
                          {paradaTitle.separator}
                          {paradaTitle.rest}
                        </>
                      ) : (
                        titol
                      )
                    }
                  </Text>
                  <div class="min-w-0 sm:text-right">
                    {
                      item.categoria && (
                        <p class="text-sm text-base-400 dark:text-base-500">
                          ({item.categoria})
                        </p>
                      )
                    }
                    {
                      item.text && (
                        <Text
                          tag="p"
                          variant="textBase"
                          class="text-base-500 dark:text-base-400 leading-relaxed mt-1"
                        >
                          {item.text}
                        </Text>
                      )
                    }
                  </div>
                </li>
              </>
            );
          })
        }
      </ol>
      <p class="mt-8 pt-6 border-t border-base-200 dark:border-base-800 text-base text-base-500 dark:text-base-400 leading-relaxed">
        Els termes d'aquest esquema són al{" "}
        <a
          href={withBase("/termes/")}
          class={paradaLinkClass}
          target="_blank"
          rel="noopener noreferrer"
        >
          glossari
        </a>
        .
      </p>
    </div>
  </div>
  {
    videoItems.map(({ item, index, video }) =>
      video ? (
        <ItinerariVideoModal
          modalId={`${modalId}-video-${index}`}
          label={video.linkPhrase ?? item.titol.replace(/^[↓⬇]\s*/u, "").trim()}
          src={video.src}
          title={video.linkPhrase ?? item.titol.replace(/^[↓⬇]\s*/u, "").trim()}
          sound={video.sound ?? true}
          allowFullscreen={video.allowFullscreen ?? true}
          fit={video.fit ?? "contain"}
          hideLabel={video.hideLabel ?? false}
          startUnmuted={video.startUnmuted ?? false}
          caption={video.caption}
        />
      ) : null,
    )
  }
</dialog>

<script>
  import { openDialogFromTrigger } from "@/utils/modalA11y";

  function initCronologiaVideoLinks() {
    document.querySelectorAll("[data-cronologia-video-target]").forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      if (btn.dataset.cronologiaVideoBound === "true") return;
      btn.dataset.cronologiaVideoBound = "true";

      const targetId = btn.dataset.cronologiaVideoTarget;
      if (!targetId) return;

      const videoDialog = document.getElementById(targetId);
      if (!(videoDialog instanceof HTMLDialogElement)) return;

      const startModalVideo = () => {
        videoDialog
          .querySelector("[data-itinerari-hero-video]")
          ?.dispatchEvent(new CustomEvent("hero-video-start"));
      };

      const resetModalVideo = () => {
        if (
          document.fullscreenElement instanceof HTMLElement &&
          videoDialog.contains(document.fullscreenElement)
        ) {
          void document.exitFullscreen();
        }
        videoDialog
          .querySelector("[data-itinerari-hero-video]")
          ?.dispatchEvent(new CustomEvent("hero-video-reset"));
      };

      btn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openDialogFromTrigger(videoDialog, btn, {
          onOpen: startModalVideo,
          onBeforeClose: resetModalVideo,
        });
      });
    });
  }

  initCronologiaVideoLinks();
  document.addEventListener("astro:after-swap", initCronologiaVideoLinks);
</script>
