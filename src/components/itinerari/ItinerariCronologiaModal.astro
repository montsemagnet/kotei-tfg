---
import Text from "@/components/fundations/elements/Text.astro";
import ItinerariModalHeaderActions from "@/components/itinerari/ItinerariModalHeaderActions.astro";
import ItinerariVideoModal from "@/components/itinerari/ItinerariVideoModal.astro";
import ItinerariModalPublicMedia from "@/components/itinerari/ItinerariModalPublicMedia.astro";
import CronologiaStepList from "@/components/itinerari/CronologiaStepList.astro";
import {
  isAnnotatedParallel,
  isParallel,
  lookupCronologiaVideo,
  resolveCronologiaItemVideo,
  type AnnotatedBranch,
  type AnnotatedCronologiaStep,
  type AnnotatedNode,
  type CronologiaNode,
  type CronologiaStep,
} from "@/components/itinerari/cronologia";
import { withBase } from "@/utils/withBase";

interface Props {
  modalId: string;
  label: string;
  intro?: string;
  items: CronologiaNode[];
  iconSrc?: string;
  arrowSrc?: string;
  outroMedia?: {
    title?: string;
    publicSrc: string;
    alt: string;
    caption?: string;
    tipus?: "animacio" | "video";
    compact?: boolean;
  };
}

const {
  modalId,
  label,
  intro,
  items,
  iconSrc = "/images/itineraris/sau-tavertet/icone-proces.png",
  arrowSrc = "/images/itineraris/sau-tavertet/fletxa.png",
  outroMedia,
} = Astro.props;

const titleId = `${modalId}-title`;
const iconUrl = withBase(iconSrc);
const arrowUrl = withBase(arrowSrc);
const panelCloseClass =
  "itinerari-dada-close rounded-full bg-base-200 dark:bg-base-800 px-4 py-2 text-sm text-base-900 dark:text-white hover:bg-base-300 dark:hover:bg-base-700";
const procesLinkClass =
  "text-left cursor-pointer text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors leading-snug";
const paradaLinkClass =
  "text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors";

let videoSeq = 0;
const videoItems: AnnotatedCronologiaStep[] = [];

function annotateStep(item: CronologiaStep): AnnotatedCronologiaStep {
  const video = resolveCronologiaItemVideo(item);
  const videoId = video ? `${modalId}-video-${videoSeq++}` : undefined;
  const processosEnriquits = item.processos?.map((titol) => {
    const procesVideo = lookupCronologiaVideo(titol);
    const procesVideoId = procesVideo
      ? `${modalId}-video-${videoSeq++}`
      : undefined;
    if (procesVideo && procesVideoId) {
      videoItems.push({
        tipus: "proces",
        titol,
        video: procesVideo,
        videoId: procesVideoId,
      });
    }
    return { titol, video: procesVideo, videoId: procesVideoId };
  });
  const annotated = { ...item, video, videoId, processosEnriquits };
  if (video && videoId) videoItems.push(annotated);
  return annotated;
}

function annotateHeading(
  titol?: string,
  text?: string,
): Pick<AnnotatedBranch, "titol" | "text" | "video" | "videoId"> {
  if (!titol) return { titol, text };
  const heading: CronologiaStep = { tipus: "proces", titol, text };
  const video = lookupCronologiaVideo(titol);
  const videoId = video ? `${modalId}-video-${videoSeq++}` : undefined;
  if (video && videoId) {
    videoItems.push({ ...heading, video, videoId });
  }
  return { titol, text, video, videoId };
}

const annotatedNodes: AnnotatedNode[] = items.map((node) => {
  if (isParallel(node)) {
    return {
      tipus: "parallel",
      titol: node.titol,
      branques: node.branques.map((branca) => ({
        ...annotateHeading(branca.titol, branca.text),
        items: branca.items.map(annotateStep),
      })),
    };
  }
  return annotateStep(node);
});
---

<dialog
  id={modalId}
  class="itinerari-dada-dialog fixed inset-0 z-[110] m-0 size-full max-h-none max-w-none border-0 bg-base-950/90 p-4 backdrop:bg-transparent open:flex open:items-start open:justify-center overflow-y-auto"
  aria-modal="true"
  aria-labelledby={titleId}
  data-focus-trap="true"
>
  <div
    class="itinerari-dada-panel relative my-8 w-full max-w-5xl rounded-lg bg-base-100 dark:bg-base-900 p-6 lg:p-10 shadow-xl"
    data-text-size-enabled="true"
    spellcheck="false"
  >
    <ItinerariModalHeaderActions closeClass={panelCloseClass} />

    <div class="itinerari-modal-text-content">
      <Text
        id={titleId}
        tag="h2"
        variant="displayMD"
        class="dark:text-white text-base-900 font-medium tracking-tighter mb-6 pr-52 leading-tight"
      >
        {label}
      </Text>

      {
        intro &&
          intro
            .split(/\n\s*\n/)
            .map((p) => p.trim())
            .filter(Boolean)
            .map((paragraph) => (
              <Text
                tag="p"
                variant="textBase"
                class="text-base-500 dark:text-base-400 mb-4 last:mb-8 leading-relaxed"
              >
                {paragraph}
              </Text>
            ))
      }

      <ol class="list-none p-0 m-0 flex flex-col">
        {
          annotatedNodes.map((node, index) => {
            if (!isAnnotatedParallel(node)) {
              const previous = annotatedNodes[index - 1];
              const previousIsProces =
                previous != null &&
                !isAnnotatedParallel(previous) &&
                previous.tipus === "proces";
              const previousIsProducte =
                previous != null &&
                !isAnnotatedParallel(previous) &&
                previous.tipus === "producte";
              return (
                <CronologiaStepList
                  items={[node]}
                  iconUrl={iconUrl}
                  arrowUrl={arrowUrl}
                  previousIsProces={previousIsProces}
                  previousIsProducte={previousIsProducte}
                />
              );
            }

            const groupTitle = node.titol?.trim() || "Processos associats";
            const branchLabel = node.branques
              .map((branca) => branca.titol)
              .filter(Boolean)
              .join(" i ");
            const next = annotatedNodes[index + 1];
            const showExitArrow = next != null && !isAnnotatedParallel(next);

            return (
              <li class="mt-4 mb-2">
                <div
                  class="flex justify-center py-2"
                  aria-hidden="true"
                >
                  <img
                    src={arrowUrl}
                    alt=""
                    class="h-8 w-auto sm:h-9"
                    width="36"
                    height="36"
                  />
                </div>
                <div
                  class="relative hidden md:block h-8 mb-1"
                  aria-hidden="true"
                >
                  <div class="absolute left-1/4 right-1/4 top-0 border-t-2 border-base-300 dark:border-base-600" />
                  <div class="absolute left-1/4 top-0 h-full border-l-2 border-base-300 dark:border-base-600" />
                  <div class="absolute right-1/4 top-0 h-full border-r-2 border-base-300 dark:border-base-600" />
                  <span class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 bg-base-100 dark:bg-base-900 px-2 text-[0.7rem] tracking-wide text-accent-700 dark:text-accent-400 text-center max-w-[min(100%,24rem)] leading-snug">
                    {groupTitle}
                  </span>
                </div>
                <div
                  class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 md:items-start"
                  role="group"
                  aria-label={
                    branchLabel
                      ? `${groupTitle}: ${branchLabel}`
                      : groupTitle
                  }
                >
                  {
                    node.branques.map((branca, branchIndex) => (
                      <div class="rounded-lg border border-base-200 dark:border-base-700 bg-base-50/70 dark:bg-base-800/40 p-3 sm:p-4">
                        {
                          branchIndex > 0 && (
                            <p class="md:hidden mb-3 text-center text-[0.7rem] tracking-wide text-accent-700 dark:text-accent-400">
                              {groupTitle}
                            </p>
                          )
                        }
                        {
                          branca.titol && (
                            <div class="flex items-start gap-2 pb-2 mb-1 border-b border-base-200/80 dark:border-base-700/80">
                              <span
                                class="mt-0.5 size-5 shrink-0 bg-accent-700 dark:bg-accent-400"
                                style={`mask: url('${iconUrl}') center / contain no-repeat; -webkit-mask: url('${iconUrl}') center / contain no-repeat; mask-mode: alpha; -webkit-mask-source-type: alpha;`}
                                aria-hidden="true"
                              />
                              <div class="min-w-0">
                                {
                                  branca.videoId ? (
                                    <button
                                      type="button"
                                      data-cronologia-video-target={branca.videoId}
                                      class={`${procesLinkClass} font-semibold`}
                                      aria-haspopup="dialog"
                                      aria-label={`Obrir vídeo: ${branca.titol}`}
                                    >
                                      {branca.titol}
                                    </button>
                                  ) : (
                                    <Text
                                      tag="p"
                                      variant="textBase"
                                      class="dark:text-white text-base-900 font-semibold leading-snug"
                                    >
                                      {branca.titol}
                                    </Text>
                                  )
                                }
                                {
                                  branca.text && (
                                    <Text
                                      tag="p"
                                      variant="textSM"
                                      class="text-base-500 dark:text-base-400 mt-1 leading-relaxed"
                                    >
                                      {branca.text}
                                    </Text>
                                  )
                                }
                              </div>
                            </div>
                          )
                        }
                        <ol class="list-none p-0 m-0 flex flex-col">
                          <CronologiaStepList
                            items={branca.items}
                            iconUrl={iconUrl}
                            arrowUrl={arrowUrl}
                            previousIsProces={Boolean(branca.titol)}
                          />
                        </ol>
                      </div>
                    ))
                  }
                </div>
                {
                  showExitArrow && (
                    <div class="flex justify-center py-2" aria-hidden="true">
                      <img
                        src={arrowUrl}
                        alt=""
                        class="h-8 w-auto sm:h-9"
                        width="36"
                        height="36"
                      />
                    </div>
                  )
                }
              </li>
            );
          })
        }
      </ol>
      {
        outroMedia && (
          <ItinerariModalPublicMedia
            media={outroMedia}
            zoomId={`${modalId}-outro`}
            class="mt-10 mb-2"
          />
        )
      }
      <p class="mt-8 pt-6 border-t border-base-200 dark:border-base-800 text-base text-base-500 dark:text-base-400 leading-relaxed">
        Els termes d'aquest esquema són al{" "}
        <a
          href={withBase("/termes/")}
          class={paradaLinkClass}
          target="_blank"
          rel="noopener noreferrer"
        >
          glossari
        </a>
        .
      </p>
    </div>
  </div>
  {
    videoItems.map((item) =>
      item.video && item.videoId ? (
        <ItinerariVideoModal
          modalId={item.videoId}
          label={item.video.linkPhrase ?? item.titol.replace(/^[↓⬇]\s*/u, "").trim()}
          src={item.video.src}
          title={item.video.linkPhrase ?? item.titol.replace(/^[↓⬇]\s*/u, "").trim()}
          sound={item.video.sound ?? true}
          allowFullscreen={item.video.allowFullscreen ?? true}
          fit={item.video.fit ?? "contain"}
          hideLabel={item.video.hideLabel ?? false}
          startUnmuted={item.video.startUnmuted ?? item.video.sound ?? true}
          caption={item.video.caption}
        />
      ) : null,
    )
  }
</dialog>

<script>
  import { openDialogFromTrigger } from "@/utils/modalA11y";

  function initCronologiaVideoLinks() {
    document.querySelectorAll("[data-cronologia-video-target]").forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      if (btn.dataset.cronologiaVideoBound === "true") return;
      btn.dataset.cronologiaVideoBound = "true";

      const targetId = btn.dataset.cronologiaVideoTarget;
      if (!targetId) return;

      const videoDialog = document.getElementById(targetId);
      if (!(videoDialog instanceof HTMLDialogElement)) return;

      const startModalVideo = () => {
        videoDialog
          .querySelector("[data-itinerari-hero-video]")
          ?.dispatchEvent(new CustomEvent("hero-video-start"));
      };

      const resetModalVideo = () => {
        if (
          document.fullscreenElement instanceof HTMLElement &&
          videoDialog.contains(document.fullscreenElement)
        ) {
          void document.exitFullscreen();
        }
        videoDialog
          .querySelector("[data-itinerari-hero-video]")
          ?.dispatchEvent(new CustomEvent("hero-video-reset"));
      };

      btn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openDialogFromTrigger(videoDialog, btn, {
          onOpen: startModalVideo,
          onBeforeClose: resetModalVideo,
        });
      });
    });
  }

  initCronologiaVideoLinks();
  document.addEventListener("astro:after-swap", initCronologiaVideoLinks);
</script>
