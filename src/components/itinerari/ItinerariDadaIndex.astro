---
import { withBase } from "@/utils/withBase";

interface IndexItem {
  label: string;
  modalKey?: string;
  href?: string;
  numbered?: boolean;
}

interface Props {
  items: IndexItem[];
  ariaLabel: string;
  /** Prefix de l'id del modal (per defecte itinerari). Ex.: `parada-geologia-I1-P1-` */
  modalIdPrefix?: string;
}

const { items, ariaLabel, modalIdPrefix = "itinerari-modal-" } = Astro.props;

const linkClass =
  "text-left cursor-pointer text-lg md:text-xl text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[4px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors leading-snug";
---

<nav class="mt-6 pl-6 sm:pl-8 lg:pl-10" aria-label={ariaLabel}>
  <ol class="flex flex-col gap-2 list-none p-0 m-0">
    {
      items.map((item, index) => {
        const modalId = item.modalKey
          ? `${modalIdPrefix}${item.modalKey}`
          : undefined;
        const displayLabel =
          item.numbered === false ? item.label : `${index + 1}. ${item.label}`;

        if (item.href) {
          const href = withBase(item.href);
          return (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                {displayLabel}
              </a>
            </li>
          );
        }

        return (
          <li>
            <button
              type="button"
              data-modal-target={modalId}
              class={linkClass}
              aria-haspopup="dialog"
              aria-label={`Obrir: ${item.label}`}
            >
              {displayLabel}
            </button>
          </li>
        );
      })
    }
  </ol>
</nav>
