---
import Text from "@/components/fundations/elements/Text.astro";
import { createTermeLinkTracker, linkTermes } from "@/utils/linkTermes";
import { withBase } from "@/utils/withBase";

export type GeologiaAmpliacio = {
  label: string;
  modalKey: string;
};

export type GeologiaCapa = {
  gif?: string;
  grup?: string;
  titol: string;
  periode?: string;
  litologia?: string;
  ambient?: string;
  paragrafs?: string[];
  ampliacionsTitol?: string;
  ampliacions?: GeologiaAmpliacio[];
  hiatus?: boolean;
  pauseMs?: number;
};

interface Props {
  capes: GeologiaCapa[];
  gif?: string;
  heading?: string;
}

const { capes, gif, heading } = Astro.props;
const gifFinal = gif ? gif.replace(/\.gif$/i, "-final.png") : "";
const linkedSlugs = createTermeLinkTracker();
const ampliacioIconSrc = withBase("/images/ui/ampliacio-coneixements.gif");
const textClass =
  "text-lg md:text-xl text-base-500 dark:text-base-400";
const ampliacioTitolClass =
  "inline-flex items-center gap-3 text-lg md:text-xl font-medium tracking-tight text-base-900 dark:text-white leading-snug";
const ampliacioLinkClass =
  "text-left cursor-pointer text-lg md:text-xl text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[4px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors leading-snug";

/** Amb flex-col-reverse el visor va de nova a antiga: el títol de grup
 *  va al primer ítem visible del grup, saltant hiatus. */
function showGrupLabel(index: number) {
  const capa = capes[index];
  if (!capa?.grup || capa.hiatus) return false;
  for (let j = index + 1; j < capes.length; j++) {
    if (capes[j].grup !== capa.grup) break;
    if (!capes[j].hiatus) return false;
  }
  return true;
}
---

<div
  class="geologia-capes grid grid-cols-1 lg:grid-cols-4 items-start gap-x-6 gap-y-2"
  data-geologia-capes
  data-capa-gif={gif ?? ""}
  data-capa-gif-final={gifFinal}
  aria-label="Successió de capes geològiques, de més antiga a més moderna"
>
  <div class="page-text-content min-w-0">
    {
      heading && (
        <Text
          tag="h2"
          variant="displayMD"
          class="dark:text-white text-base-900 font-medium tracking-tighter capitalize leading-tight break-words"
        >
          {heading}
        </Text>
      )
    }
    <div class="geologia-capes-visual mt-3">
      <figure class="geologia-capes-figure" data-capa-figure>
        <img
          data-capa-gif-img
          src=""
          alt=""
          class="geologia-capes-img bg-transparent"
        />
        <figcaption class="sr-only">
          Columna esquemàtica de capes, de més antiga (a baix) a més moderna (a dalt).
        </figcaption>
      </figure>
      <div class="geologia-capes-base" aria-hidden="true"></div>
    </div>
  </div>

    <div class="geologia-capes-text page-text-content min-w-0 lg:col-span-3">
      <ol class="flex flex-col-reverse gap-3">
        {
          capes.map((capa, index) => {
            const hasText = Boolean(
              capa.titol ||
                capa.grup ||
                capa.periode ||
                capa.litologia ||
                capa.ambient ||
                (capa.paragrafs && capa.paragrafs.length > 0) ||
                (capa.ampliacions && capa.ampliacions.length > 0),
            );
            if (!hasText) return null;
            const showGrup = showGrupLabel(index);
            return (
              <li
                data-capa-index={index}
                data-linia-base={index === capes.length - 3 ? true : undefined}
                data-aos="fade-up"
                data-aos-duration="1500"
                data-aos-delay={String((capes.length - 1 - index) * 80)}
              >
                {showGrup && capa.grup && (
                  <p class="mb-1.5 text-xs font-medium uppercase tracking-[0.14em] text-base-400 dark:text-base-500">
                    {capa.grup}
                  </p>
                )}
                <article
                  class:list={[
                    capa.paragrafs && capa.paragrafs.length > 0
                      ? ""
                      : [
                          "rounded-xl border px-4 py-3",
                          capa.hiatus
                            ? "border-dashed border-base-300 bg-base-50/80 dark:border-base-600 dark:bg-base-900/40"
                            : "border-base-200 bg-white/70 dark:border-base-800 dark:bg-base-950/40",
                        ],
                  ]}
                >
                  <h3
                    class:list={[
                      capa.paragrafs && capa.paragrafs.length > 0
                        ? textClass
                        : "text-base md:text-lg font-medium tracking-tight text-base-900 dark:text-white",
                    ]}
                    set:html={linkTermes(capa.titol, linkedSlugs)}
                  />
                  {capa.periode && (
                    <p
                      class="mt-1 text-sm text-base-500 dark:text-base-400"
                      set:html={linkTermes(capa.periode, linkedSlugs)}
                    />
                  )}
                  {capa.litologia && (
                    <p
                      class="mt-1 text-sm leading-relaxed text-base-600 dark:text-base-300"
                      set:html={linkTermes(capa.litologia, linkedSlugs)}
                    />
                  )}
                  {capa.ambient && (
                    <p
                      class="mt-2 text-sm md:text-base leading-relaxed text-base-500 dark:text-base-400"
                      set:html={linkTermes(capa.ambient, linkedSlugs)}
                    />
                  )}
                  {capa.paragrafs?.map((paragraf) => (
                    <p
                      class:list={["mt-3", textClass]}
                      set:html={linkTermes(paragraf, linkedSlugs)}
                    />
                  ))}
                </article>
                {
                  (capa.ampliacionsTitol ||
                    (capa.ampliacions && capa.ampliacions.length > 0)) && (
                    <div class="mt-5">
                      {capa.ampliacionsTitol && (
                        <p class={ampliacioTitolClass}>
                          <img
                            src={ampliacioIconSrc}
                            alt=""
                            width="80"
                            height="80"
                            class="size-20 shrink-0 bg-transparent"
                          />
                          <span>{capa.ampliacionsTitol}</span>
                        </p>
                      )}
                      {capa.ampliacions && capa.ampliacions.length > 0 && (
                        <ul class="mt-3 flex flex-col gap-2 list-none p-0 m-0">
                          {capa.ampliacions.map((ampliacio) => (
                            <li>
                              <button
                                type="button"
                                data-modal-target={`itinerari-modal-${ampliacio.modalKey}`}
                                class={ampliacioLinkClass}
                                aria-haspopup="dialog"
                                aria-label={`Ampliació de coneixements: ${ampliacio.label}`}
                              >
                                {ampliacio.label}
                              </button>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  )
                }
              </li>
            );
          })
        }
      </ol>
    </div>
</div>

<style>
  .geologia-capes-visual {
    width: 12.5rem;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .geologia-capes-figure {
    display: block;
    width: 100%;
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    overflow: hidden;
  }

  .geologia-capes-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom center;
    background: transparent;
    opacity: 0;
    visibility: hidden;
  }

  .geologia-capes-figure.is-ready .geologia-capes-img {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease;
  }

  .geologia-capes-base {
    display: block;
    width: 100%;
    height: 8px;
    flex-shrink: 0;
    margin: 0;
    background: #111;
  }

  .geologia-capes-text {
    min-width: 0;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .geologia-capes-figure.is-ready .geologia-capes-img {
      transition: none;
    }
  }
</style>

<script>
  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function initGeologiaCapes(root: HTMLElement) {
    if (root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const img = root.querySelector<HTMLImageElement>("[data-capa-gif-img]");
    const figure = root.querySelector<HTMLElement>("[data-capa-figure]");
    const visual = root.querySelector<HTMLElement>(".geologia-capes-visual");
    const liniaCapa = root.querySelector<HTMLElement>("[data-linia-base]");
    const gif = root.dataset.capaGif ?? "";
    const still = root.dataset.capaGifFinal ?? "";
    if (!img || !figure || !gif) return;

    const syncLinia = () => {
      if (!visual) return;
      const desktop = window.matchMedia("(min-width: 768px)").matches;
      if (desktop && liniaCapa) {
        const top = visual.getBoundingClientRect().top;
        const bottom = liniaCapa.getBoundingClientRect().bottom;
        visual.style.height = `${Math.max(0, bottom - top)}px`;
      } else {
        visual.style.removeProperty("height");
      }
    };

    const startOnce = () => {
      img.src = prefersReducedMotion() && still ? still : gif;
      figure.classList.add("is-ready");
      requestAnimationFrame(syncLinia);
    };

    window.addEventListener("resize", syncLinia);
    requestAnimationFrame(syncLinia);

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          startOnce();
        }
      },
      { threshold: 0.15 },
    );
    observer.observe(root);
  }

  function bindAll() {
    document
      .querySelectorAll<HTMLElement>("[data-geologia-capes]")
      .forEach(initGeologiaCapes);
  }

  bindAll();
  document.addEventListener("astro:after-swap", bindAll);
</script>
