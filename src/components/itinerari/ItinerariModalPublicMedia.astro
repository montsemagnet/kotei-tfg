---
import Text from "@/components/fundations/elements/Text.astro";
import ItinerariZoom from "@/components/itinerari/ItinerariZoom.astro";
import ItinerariHeroVideo from "@/components/itinerari/ItinerariHeroVideo.astro";
import { linkTermes } from "@/utils/linkTermes";
import { withBase } from "@/utils/withBase";

interface Props {
  media: {
    title?: string;
    publicSrc: string;
    alt: string;
    caption?: string;
    tipus?: "animacio" | "video";
    compact?: boolean;
  };
  zoomId: string;
  class?: string;
}

const { media, zoomId, class: className = "my-6" } = Astro.props;
const titleHtml = media.title ? linkTermes(media.title) : undefined;
const isVideo = media.tipus === "video";
const assetSrc = withBase(media.publicSrc);

const zoomThumbClass = media.compact
  ? "mx-auto block w-full max-w-[16rem] sm:max-w-sm cursor-pointer overflow-hidden border-0 p-0 bg-transparent hover:opacity-90 transition-opacity"
  : "w-full cursor-pointer overflow-hidden border-0 p-0 bg-transparent hover:opacity-90 transition-opacity";
const zoomImageClass =
  "w-full h-auto rounded-md border border-base-200 dark:border-base-800";
---

<div class={className}>
  {
    titleHtml && (
      <Text
        tag="h4"
        variant="textBase"
        class="dark:text-white text-base-900 font-medium mb-3 leading-snug"
        spellcheck="false"
        set:html={titleHtml}
      />
    )
  }
  {
    isVideo ? (
      <figure class="itinerari-modal-media">
        <div class="rounded-md border border-base-200 dark:border-base-800">
          <ItinerariHeroVideo
            src={assetSrc}
            title={media.alt}
            allowFullscreen
            autoplayOnMount={false}
          />
        </div>
        {media.caption && (
          <figcaption class="mt-2 text-sm text-base-500 dark:text-base-400 leading-relaxed" spellcheck="false">
            {media.caption}
          </figcaption>
        )}
      </figure>
    ) : (
      <ItinerariZoom zoomId={zoomId}>
        <figure class="itinerari-modal-media">
          <button
            type="button"
            class={zoomThumbClass}
            data-itinerari-zoom
            data-full-src={assetSrc}
            aria-label={`Ampliar: ${media.alt}`}
          >
            <img
              src={assetSrc}
              alt={media.alt}
              class={zoomImageClass}
              loading="lazy"
              decoding="async"
            />
          </button>
          {media.caption && (
            <figcaption class="mt-2 text-sm text-base-500 dark:text-base-400 leading-relaxed" spellcheck="false">
              {media.caption}
            </figcaption>
          )}
        </figure>
      </ItinerariZoom>
    )
  }
</div>
