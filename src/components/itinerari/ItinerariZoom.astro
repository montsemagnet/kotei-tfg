---
interface Props {
  zoomId: string;
}

const { zoomId } = Astro.props;
const overlayCloseClass =
  "itinerari-zoom-close itinerari-overlay-close text-sm font-medium";
---

<div data-itinerari-zoom-root={zoomId}>
  <slot />

  <dialog
    id={`itinerari-zoom-${zoomId}`}
    class="itinerari-zoom-dialog fixed inset-0 z-[120] m-0 size-full max-h-none max-w-none border-0 bg-black p-3 sm:p-4 backdrop:bg-transparent open:flex open:items-center open:justify-center"
    aria-modal="true"
    data-focus-trap="true"
  >
    <div class="itinerari-zoom-stage relative flex size-full max-h-full max-w-full flex-col items-center justify-center">
      <div class="absolute top-3 right-3 z-10 flex items-center gap-2 sm:top-4 sm:right-4">
        <button
          type="button"
          class="itinerari-zoom-fullscreen itinerari-overlay-close text-sm font-medium"
          aria-label="Pantalla completa"
        >
          Pantalla completa
        </button>
        <button
          type="button"
          class={overlayCloseClass}
          aria-label="Tancar"
        >
          Tancar
        </button>
      </div>
      <figure class="flex max-h-full w-full max-w-full flex-col items-center">
        <img
          class="itinerari-zoom-image mx-auto max-h-[calc(100dvh-5.5rem)] w-auto max-w-full object-contain"
          src=""
          alt=""
        />
        <figcaption
          class="itinerari-zoom-caption mt-3 max-w-4xl px-4 text-center text-sm text-white"
        />
      </figure>
    </div>
  </dialog>
</div>

<script>
  import { openDialogFromTrigger } from "@/utils/modalA11y";

  let hostSourceDialog = null;
  let pausedDialogs = [];
  let skipDialogCloseCleanup = false;
  let leavingFullscreen = false;

  function openZoomFromTrigger(btn) {
    const root = btn.closest("[data-itinerari-zoom-root]");
    if (!(root instanceof HTMLElement)) return;

    const dialog = root.querySelector(".itinerari-zoom-dialog");
    if (!(dialog instanceof HTMLDialogElement)) return;

    const previewImage = dialog.querySelector(".itinerari-zoom-image");
    const previewCaption = dialog.querySelector(".itinerari-zoom-caption");
    if (
      !(previewImage instanceof HTMLImageElement) ||
      !(previewCaption instanceof HTMLElement)
    ) {
      return;
    }

    const thumb = btn.querySelector("img");
    // En local, data-full-src (image.url.src) pot ser una ruta /src/ que no existeix.
    // La miniatura ja té l'URL que Vite/Astro serveix de veritat.
    const fullSrc =
      (thumb instanceof HTMLImageElement ? thumb.currentSrc || thumb.src : "") ||
      btn.dataset.fullSrc ||
      "";
    if (!fullSrc) return;

    const alt =
      btn.dataset.alt ||
      (thumb instanceof HTMLImageElement && thumb.alt) ||
      btn.getAttribute("aria-label") ||
      "";
    const caption = btn.dataset.caption || alt;

    previewImage.src = fullSrc;
    previewImage.alt = alt;
    previewCaption.textContent = caption;
    if (dialog.open) dialog.close();
    openDialogFromTrigger(dialog, btn, {
      onOpen: () => {
        syncZoomFullscreenButton(dialog);
      },
      onBeforeClose: () => {
        if (skipDialogCloseCleanup) return;
        tearDownFullscreenHost();
      },
    });
  }

  function getFullscreenElement() {
    return document.fullscreenElement || document.webkitFullscreenElement || null;
  }

  function pauseOpenDialogs() {
    pausedDialogs = Array.from(document.querySelectorAll("dialog[open]")).filter(
      (dialog) => dialog instanceof HTMLDialogElement,
    );
    skipDialogCloseCleanup = true;
    pausedDialogs.forEach((dialog) => {
      if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
    });
    skipDialogCloseCleanup = false;
  }

  function restorePausedDialogs(includeZoom) {
    const source = hostSourceDialog;
    const toRestore = pausedDialogs.filter((dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return false;
      if (!includeZoom && dialog === source) return false;
      return true;
    });
    pausedDialogs = [];
    toRestore.forEach((dialog) => {
      if (dialog.open) return;
      try {
        dialog.showModal();
      } catch {
        dialog.show();
      }
    });
  }

  function bindFullscreenHost(host) {
    if (host.dataset.fsBound === "true") return;
    host.dataset.fsBound = "true";

    const handleHostAction = (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest(".itinerari-zoom-fs-exit")) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        void leaveImageFullscreen(false);
        return;
      }

      if (target.closest(".itinerari-zoom-fs-close")) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        void leaveImageFullscreen(true);
      }
    };

    host.addEventListener("pointerup", handleHostAction, true);
    host.addEventListener("click", handleHostAction, true);
    host.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        void leaveImageFullscreen(false);
      }
    });
  }

  function getFullscreenHost() {
    let host = document.getElementById("itinerari-zoom-fs-host");
    if (host instanceof HTMLElement) {
      bindFullscreenHost(host);
      return host;
    }

    host = document.createElement("div");
    host.id = "itinerari-zoom-fs-host";
    host.className = "itinerari-zoom-fs-host";
    host.hidden = true;
    host.setAttribute("role", "dialog");
    host.setAttribute("aria-modal", "true");
    host.setAttribute("aria-label", "Imatge a pantalla completa");
    host.innerHTML = `
      <div class="itinerari-zoom-fs-actions">
        <button type="button" class="itinerari-zoom-fs-exit itinerari-overlay-close text-sm font-medium">Sortir</button>
        <button type="button" class="itinerari-zoom-fs-close itinerari-overlay-close text-sm font-medium">Tancar</button>
      </div>
      <figure class="itinerari-zoom-fs-figure">
        <img class="itinerari-zoom-fs-image" src="" alt="" />
        <figcaption class="itinerari-zoom-fs-caption"></figcaption>
      </figure>
    `;
    document.body.appendChild(host);
    bindFullscreenHost(host);
    return host;
  }

  function hideFullscreenHost() {
    const host = document.getElementById("itinerari-zoom-fs-host");
    if (host instanceof HTMLElement) host.hidden = true;
  }

  function tearDownFullscreenHost() {
    hideFullscreenHost();
    if (getFullscreenElement()) exitFullscreenSafe();
    hostSourceDialog = null;
    pausedDialogs = [];
  }

  function isZoomFullscreen(dialog) {
    const host = document.getElementById("itinerari-zoom-fs-host");
    return Boolean(
      host instanceof HTMLElement && !host.hidden && hostSourceDialog === dialog,
    );
  }

  function syncZoomFullscreenButton(dialog) {
    const btn = dialog.querySelector(".itinerari-zoom-fullscreen");
    if (!(btn instanceof HTMLButtonElement)) return;
    const active = isZoomFullscreen(dialog);
    btn.textContent = active ? "Sortir" : "Pantalla completa";
    btn.setAttribute(
      "aria-label",
      active ? "Sortir de pantalla completa" : "Pantalla completa",
    );
    btn.setAttribute("aria-pressed", active ? "true" : "false");
  }

  function exitFullscreenSafe() {
    if (document.exitFullscreen) {
      void document.exitFullscreen();
      return;
    }
    if (document.webkitExitFullscreen) {
      document.webkitExitFullscreen();
    }
  }

  function enterImageFullscreen(dialog) {
    const image = dialog.querySelector(".itinerari-zoom-image");
    const caption = dialog.querySelector(".itinerari-zoom-caption");
    if (!(image instanceof HTMLImageElement)) return;

    const host = getFullscreenHost();
    const hostImage = host.querySelector(".itinerari-zoom-fs-image");
    const hostCaption = host.querySelector(".itinerari-zoom-fs-caption");
    if (!(hostImage instanceof HTMLImageElement) || !(hostCaption instanceof HTMLElement)) {
      return;
    }

    hostImage.src = image.currentSrc || image.src;
    hostImage.alt = image.alt;
    hostCaption.textContent = caption instanceof HTMLElement ? caption.textContent : "";
    host.hidden = false;
    hostSourceDialog = dialog;
    pauseOpenDialogs();
    host.querySelector(".itinerari-zoom-fs-exit")?.focus();

    if (host.requestFullscreen) {
      try {
        const result = host.requestFullscreen({ navigationUI: "hide" });
        if (result && typeof result.catch === "function") {
          result.catch(() => {
            try {
              void host.requestFullscreen();
            } catch {
              /* la capa ja tapa la pàgina */
            }
          });
        }
      } catch {
        try {
          void host.requestFullscreen();
        } catch {
          /* la capa ja tapa la pàgina */
        }
      }
      return;
    }
    if (host.webkitRequestFullscreen) {
      host.webkitRequestFullscreen();
    }
  }

  async function leaveImageFullscreen(closeZoom) {
    if (leavingFullscreen) return;
    leavingFullscreen = true;
    const source = hostSourceDialog;
    hideFullscreenHost();
    try {
      if (getFullscreenElement() && document.exitFullscreen) {
        await document.exitFullscreen();
      } else if (getFullscreenElement() && document.webkitExitFullscreen) {
        document.webkitExitFullscreen();
      }
    } catch {
      /* ja fora de pantalla completa */
    }
    restorePausedDialogs(!closeZoom);
    hostSourceDialog = null;
    leavingFullscreen = false;
    if (source instanceof HTMLDialogElement) syncZoomFullscreenButton(source);
  }

  function toggleZoomFullscreen(dialog) {
    if (isZoomFullscreen(dialog)) {
      leaveImageFullscreen(false);
      return;
    }
    enterImageFullscreen(dialog);
  }

  function onZoomClick(event) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const fullscreenBtn = target.closest(".itinerari-zoom-fullscreen");
    if (fullscreenBtn instanceof HTMLElement) {
      const dialog = fullscreenBtn.closest("dialog");
      if (dialog instanceof HTMLDialogElement) {
        event.preventDefault();
        event.stopPropagation();
        toggleZoomFullscreen(dialog);
        syncZoomFullscreenButton(dialog);
      }
      return;
    }

    const btn = target.closest("[data-itinerari-zoom]");
    if (!(btn instanceof HTMLElement)) return;
    event.preventDefault();
    event.stopPropagation();
    openZoomFromTrigger(btn);
  }

  function initItinerariZoom() {
    if (document.documentElement.dataset.itinerariZoomDelegated === "true") return;
    document.documentElement.dataset.itinerariZoomDelegated = "true";
    document.addEventListener("click", onZoomClick);
    const onFullscreenChange = () => {
      const host = document.getElementById("itinerari-zoom-fs-host");
      const full = getFullscreenElement();
      if (host instanceof HTMLElement && !host.hidden && !full && hostSourceDialog) {
        void leaveImageFullscreen(false);
      }
    };
    document.addEventListener("fullscreenchange", onFullscreenChange);
    document.addEventListener("webkitfullscreenchange", onFullscreenChange);
  }

  initItinerariZoom();
  document.addEventListener("astro:after-swap", initItinerariZoom);
</script>

<style is:global>
  .itinerari-zoom-fs-host {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    padding: 1rem;
  }

  .itinerari-zoom-fs-host[hidden] {
    display: none !important;
  }

  .itinerari-zoom-fs-host:fullscreen,
  .itinerari-zoom-fs-host:-webkit-full-screen {
    width: 100% !important;
    height: 100% !important;
    background: #000 !important;
  }

  .itinerari-zoom-fs-actions {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2147483647;
    display: flex;
    gap: 0.5rem;
    pointer-events: auto;
  }

  .itinerari-zoom-fs-actions button {
    pointer-events: auto;
    cursor: pointer;
  }

  .itinerari-zoom-fs-figure {
    display: flex;
    max-height: 100%;
    width: 100%;
    max-width: 100%;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .itinerari-zoom-fs-image {
    display: block;
    width: auto;
    max-width: 100vw;
    height: auto;
    max-height: calc(100dvh - 5.5rem);
    object-fit: contain;
    pointer-events: none;
  }

  .itinerari-zoom-fs-caption {
    margin-top: 0.75rem;
    max-width: 56rem;
    padding: 0 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: #fff;
  }
</style>
