---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { withBase } from "@/utils/withBase";

const verdFulla = "#1E6B42";

const landingLinks = [
  { href: "#que-hi-trobaras", label: "Què hi trobaràs" },
  { href: withBase("/itineraris"), label: "Itineraris" },
  { href: "#equip", label: "Equip" },
];

const linkClass =
  "text-sm sm:text-base text-[#1E6B42] font-medium tracking-tight underline decoration-[#1E6B42]/40 underline-offset-[6px] hover:text-[#14532D] hover:decoration-[#14532D] transition-colors text-center";
---

<section>
  <Wrapper variant="standard" class="pt-28 pb-4 sm:pt-16 lg:pt-20 lg:pb-6">
    <div class="flex flex-col items-center text-center">
      <nav class="relative z-[110] w-full px-16 sm:px-0" aria-label="Seccions de la pàgina d'inici">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:gap-x-8">
          {
            landingLinks.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-6 flex w-full max-w-full flex-col items-center">
        <Text
          tag="h1"
          variant="display4XL"
          data-aos="fade-down"
          data-aos-duration="1500"
          class="font-medium tracking-tighter text-center"
          style={`color: ${verdFulla}`}
        >
          Itineraris Biològics
        </Text>

        <Text
          tag="p"
          variant="displayMD"
          data-aos="fade-up"
          data-aos-duration="1500"
          data-aos-delay="150"
          class="mt-3 font-medium tracking-tight text-center"
          style={`color: ${verdFulla}`}
        >
          UVic-UCC
        </Text>
      </div>
    </div>
  </Wrapper>
</section>
