---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { withBase } from "@/utils/withBase";

interface Props {
  hideIllustration?: boolean;
  textOnDark?: boolean;
  /** Verd més llegible (fulla), només per proves que ho demanin. */
  lletraVerda?: boolean;
  /** Negre del text de la web, per comparar amb el verd. */
  lletraNegra?: boolean;
}

const {
  textOnDark = false,
  lletraVerda = false,
  lletraNegra = false,
} = Astro.props;

const verdFulla = "#1E6B42";
const verdSamarreta = "#1B2F26";
const titolColor = textOnDark
  ? "#F6F3EC"
  : lletraNegra
    ? undefined
    : lletraVerda
      ? verdFulla
      : verdSamarreta;
const titolClass = lletraNegra
  ? "font-medium tracking-tighter text-center text-[#171717] dark:text-white"
  : "font-medium tracking-tighter text-center";
const subtitolClass = lletraNegra
  ? "mt-3 font-medium tracking-tight text-center text-[#171717] dark:text-white"
  : "mt-3 font-medium tracking-tight text-center";

const landingLinks = [
  { href: "#que-hi-trobaras", label: "Què hi trobaràs" },
  { href: withBase("/itineraris"), label: "Itineraris" },
  { href: "#equip", label: "Equip" },
];

const linkClass = textOnDark
  ? "text-sm sm:text-base text-[#F6F3EC] font-medium tracking-tight underline decoration-white/50 underline-offset-[6px] hover:text-white hover:decoration-white transition-colors text-center"
  : lletraNegra
    ? "text-sm sm:text-base text-[#171717] dark:text-white font-medium tracking-tight underline decoration-[#171717]/35 dark:decoration-white/40 underline-offset-[6px] hover:text-black hover:decoration-black dark:hover:text-[#F6F3EC] dark:hover:decoration-white transition-colors text-center"
    : lletraVerda
      ? "text-sm sm:text-base text-[#1E6B42] font-medium tracking-tight underline decoration-[#1E6B42]/40 underline-offset-[6px] hover:text-[#14532D] hover:decoration-[#14532D] transition-colors text-center"
      : "text-sm sm:text-base text-base-900 dark:text-white font-medium tracking-tight underline decoration-base-300 dark:decoration-base-700 underline-offset-[6px] hover:text-accent-600 dark:hover:text-accent-400 hover:decoration-accent-500 dark:hover:decoration-accent-400 transition-colors text-center";
---

<section>
  <Wrapper variant="standard" class="pt-16 pb-4 lg:pt-20 lg:pb-6">
    <div class="flex flex-col items-center text-center">
      <nav aria-label="Seccions de la pàgina d'inici">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:gap-x-8">
          {
            landingLinks.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-6 flex w-full max-w-full flex-col items-center">
        <Text
          tag="h1"
          variant="display4XL"
          data-aos="fade-down"
          data-aos-duration="1500"
          class={titolClass}
          style={titolColor ? `color: ${titolColor}` : undefined}
        >
          Itineraris Biològics
        </Text>

        <Text
          tag="p"
          variant="displayMD"
          data-aos="fade-up"
          data-aos-duration="1500"
          data-aos-delay="150"
          class={subtitolClass}
          style={titolColor ? `color: ${titolColor}` : undefined}
        >
          UVic-UCC
        </Text>
      </div>
    </div>
  </Wrapper>
</section>
