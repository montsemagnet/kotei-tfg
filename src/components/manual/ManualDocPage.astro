---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ItinerariModalTextSizeControls from "@/components/itinerari/ItinerariModalTextSizeControls.astro";
import { manualParts } from "@/data/manual-parts";
import { withBase } from "@/utils/withBase";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  pageTitle: string;
  description: string;
  headings: Heading[];
  currentSlug: (typeof manualParts)[number]["slug"];
}

const { pageTitle, description, headings, currentSlug } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const otherParts = manualParts.filter((part) => part.slug !== currentSlug);
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <section>
    <Wrapper variant="standard" class="py-24 lg:py-32 max-w-4xl">
      <div data-text-size-enabled>
        <p class="mb-6">
          <a
            href={withBase("/manual/")}
            class="text-sm text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400"
          >
            ← Manual d'incorporació
          </a>
        </p>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <Text
            tag="h1"
            variant="displayXL"
            class="dark:text-white text-base-900 font-medium tracking-tighter min-w-0 flex-1"
          >
            {pageTitle}
          </Text>
          <ItinerariModalTextSizeControls label="Mida del text del manual" />
        </div>

        <slot name="intro" />

        {
          toc.length > 0 && (
            <nav
              aria-label="Contingut d'aquesta pàgina"
              class="mt-10 rounded-lg border border-base-200 dark:border-base-700 bg-base-50 dark:bg-base-800/50 p-5"
            >
              <Text
                tag="h2"
                variant="textSM"
                class="font-medium uppercase tracking-wide text-base-900 dark:text-white"
              >
                Contingut
              </Text>
              <ul class="mt-3 space-y-2 list-none p-0 text-base">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="text-base text-base-700 dark:text-base-300 hover:text-accent-500 dark:hover:text-accent-300 duration-300"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <Wrapper
          variant="prose"
          class="mt-12 itinerari-modal-text-content manual-prose prose-lg"
        >
          <slot />
        </Wrapper>

        <div class="mt-16 pt-8 border-t border-base-200 dark:border-base-800">
          <Text
            tag="h2"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-base-900 dark:text-white"
          >
            Contacte i suport
          </Text>
          <p class="mt-3 text-base text-base-700 dark:text-base-300 leading-relaxed">
            <strong class="text-base-900 dark:text-white">Montserrat Magnet Sabata</strong>
            {" — "}
            <a
              href="mailto:mariamontserrat.magnet@uvic.cat"
              class="text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400"
            >
              mariamontserrat.magnet@uvic.cat
            </a>
          </p>
          <p class="mt-2 text-sm text-base-600 dark:text-base-400">
            Abast del suport: només peticions de professorat universitari i/o del
            servei d’informàtica de la UVic.
          </p>
        </div>

        <nav
          aria-label="Altres parts del manual"
          class="mt-16 pt-8 border-t border-base-200 dark:border-base-800"
        >
          <Text
            tag="h2"
            variant="textSM"
            class="font-medium uppercase tracking-wide text-base-900 dark:text-white"
          >
            Altres parts del manual
          </Text>
          <ul class="mt-3 space-y-2 list-none p-0">
            {
              otherParts.map((part) => (
                <li>
                  <a
                    href={withBase(`/manual/${part.slug}/`)}
                    class="text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400"
                  >
                    {part.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<style>
  .manual-prose {
    font-size: 1.125rem;
    line-height: 1.8;
  }
  .manual-prose :global(pre) {
    overflow-x: auto;
    font-size: 0.95em;
    color: #f3f4f6;
    background-color: #111827;
  }
  .manual-prose :global(pre code) {
    color: inherit;
    background-color: transparent;
  }
  .manual-prose :global(table) {
    display: block;
    overflow-x: auto;
    font-size: 1em;
  }
  .manual-prose :global(h2) {
    font-size: 1.5em;
  }
  .manual-prose :global(h3) {
    font-size: 1.25em;
  }
  .manual-prose :global(h4) {
    font-size: 1.125em;
  }
</style>
