---
// Assets
import { Image } from "astro:assets";
// Layouts i Components
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import TitleIconTrigger from "@/components/fundations/elements/TitleIconTrigger.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ItinerariHeroVideo from "@/components/itinerari/ItinerariHeroVideo.astro";
import ItinerariSau from "@/components/itinerari/itinerari-sau.astro";
import ItinerariVideoModal from "@/components/itinerari/ItinerariVideoModal.astro";
import ItinerariPaleogeologiaModal from "@/components/itinerari/ItinerariPaleogeologiaModal.astro";
import ItinerariDadaModal from "@/components/itinerari/ItinerariDadaModal.astro";
import ItinerariCronologiaModal from "@/components/itinerari/ItinerariCronologiaModal.astro";
import ItinerariDadaIndex from "@/components/itinerari/ItinerariDadaIndex.astro";
import ItinerariDadesArticle from "@/components/itinerari/ItinerariDadesArticle.astro";
import ItinerariZoom from "@/components/itinerari/ItinerariZoom.astro";
import GlossariSection from "@/components/global/GlossariSection.astro";
import { withBase } from "@/utils/withBase";

const { frontmatter } = Astro.props;

const defaultDadesLabels: Record<string, string> = {
  ubicacio: "ubicació",
  mapa: "Mapa QGIS geològic",
  socle: "sòcol",
  paleogeologia: "paleogeologia",
  historia: "història",
  paisatge: "paisatge i flora",
  mapaGeobotanica: "Mapa QGIS geobotànic",
};

const dadesDisplayOrder = [
  "ubicacio",
  "socle",
  "paleogeologia",
  "historia",
  "paisatge",
];

const dadesSections = Object.entries(frontmatter.dades).sort(([keyA], [keyB]) => {
  const rank = (key: string) => {
    const i = dadesDisplayOrder.indexOf(key);
    return i === -1 ? dadesDisplayOrder.length : i;
  };
  return rank(keyA) - rank(keyB);
});

const dadesLabels: Record<string, string> = {
  ...defaultDadesLabels,
  ...frontmatter.dadesLabels,
};

const videoModalId = "itinerari-modal-visualitzacio";
const altimetriaModalId = "itinerari-modal-altimetria";
const videoEnModal = frontmatter.video?.enModal ?? false;
const hasInlineMap = frontmatter.mapa === "sau-tavertet";
const heroWrapperClass = hasInlineMap
  ? "pt-28 pb-8 sm:pt-16 lg:pt-20 lg:pb-10"
  : "pt-28 pb-24 sm:pt-16 lg:py-48";
const contentWrapperClass = hasInlineMap ? "pt-4 pb-8 lg:pt-6" : "py-8";
const introParadaLinkClass =
  "text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[4px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors";

const introParagraphs = frontmatter.intro.flatMap((item) => item.paragraphs ?? []);
const introTable = frontmatter.intro.find((item) => item.table)?.table;
const mapaHref = frontmatter.mapaUrl ? withBase(frontmatter.mapaUrl) : undefined;
const mapaGeobotanicaHref = frontmatter.mapaGeobotanicaUrl
  ? withBase(frontmatter.mapaGeobotanicaUrl)
  : undefined;

const recorregutItems = [
  ...(frontmatter.rutaMobil
    ? [
        {
          label: frontmatter.rutaMobil.label,
          href: frontmatter.rutaMobil.publicSrc,
          download: frontmatter.rutaMobil.downloadName ?? true,
          description: frontmatter.rutaMobil.description,
        },
      ]
    : []),
  ...(videoEnModal && frontmatter.video
    ? [
        {
          label: frontmatter.video.modalLabel ?? "Visualització de la zona",
          videoModalTarget: videoModalId,
          description: frontmatter.video.alt,
        },
      ]
    : []),
  ...(frontmatter.altimetria
    ? [
        {
          label: frontmatter.altimetria.label,
          videoModalTarget: altimetriaModalId,
          description: frontmatter.altimetria.description,
        },
      ]
    : []),
];
const hasRecorregut = recorregutItems.length > 0;
const dadesArticle = frontmatter.dadesArticle ?? [];
const hasGeologia = dadesSections.some(([key]) => key === "historia");
const hasMapes = Boolean(mapaHref || mapaGeobotanicaHref);
const pageLinkClass =
  "text-sm sm:text-base text-[#1E6B42] font-medium tracking-tight underline decoration-[#1E6B42]/40 underline-offset-[6px] hover:text-[#14532D] hover:decoration-[#14532D] transition-colors text-center";
const pageLinks = [
  { href: "#descripcio-recorregut", label: "Descripció i recorregut" },
  ...(hasGeologia ? [{ href: "#geologia", label: "Geologia" }] : []),
  ...(introTable ? [{ href: "#parades", label: "Parades" }] : []),
  ...(hasMapes
    ? [{ href: "#mapes", label: "Mapes interactius i links d'interès" }]
    : []),
];
const mapesItems = [
  ...(mapaHref
    ? [
        {
          label: dadesLabels.mapa ?? "Mapa QGIS geològic",
          href: mapaHref,
          numbered: false as const,
        },
      ]
    : []),
  ...(mapaGeobotanicaHref
    ? [
        {
          label: dadesLabels.mapaGeobotanica ?? "Mapa QGIS geobotànic",
          href: mapaGeobotanicaHref,
          numbered: false as const,
        },
      ]
    : []),
  ...(hasInlineMap
    ? [
        {
          label: "Fitxa de la geozona Cingles de Tavertet–El Far",
          href: "https://mediambient.repositori.gencat.cat/bitstream/handle/20.500.14343/2170/2000_Cingles_Tavertet_Far_fitxa_descriptiva.pdf?sequence=1&isAllowed=y",
          numbered: false as const,
        },
        {
          label: "L'Avinguda dels Temps Geològics (ICGC)",
          href: "https://www.icgc.cat/ca/Eines-i-visors/Apps/PGOM-Pirineus-Geological-Open-Museum/Recorreguts/LAvinguda-dels-Temps-Geologics",
          numbered: false as const,
        },
        {
          label: "Jerarquia d'unitats cronostratigràfiques (ICGC)",
          href: "https://datacloud.icgc.cat/datacloud/descarregues-web/bd/pubs/ChronostratChart2023-09Catalan.pdf",
          numbered: false as const,
        },
      ]
    : []),
];
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
>
  <section>
    <div data-text-size-enabled>
    <Wrapper variant="standard" class={heroWrapperClass}>
      {
        pageLinks.length > 0 && (
          <nav
            class="relative z-[110] mb-8 w-full px-16 sm:px-0"
            aria-label="Seccions de l'itinerari"
          >
            <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:gap-x-8">
              {pageLinks.map((item) => (
                <li>
                  <a href={item.href} class={pageLinkClass}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="mb-8 min-w-0 itinerari-title-wrap">
        <Text
          tag="h1"
          variant="textBase"
          data-aos="fade-up"
          data-aos-duration="1000"
          class="itinerari-page-title dark:text-white text-base-900 font-medium tracking-tighter w-full max-w-none"
        >
          {
            frontmatter.titleParts ? (
              <>
                {
                  frontmatter.titleParts.lead && (
                    <>
                      {frontmatter.titleParts.lead}
                      <span class="itinerari-title-from">
                        {frontmatter.titleParts.from}
                      </span>
                    </>
                  )
                }
                {!frontmatter.titleParts.lead && frontmatter.titleParts.from}
                <img
                  src={withBase("/images/ui/flecha-itinerari.gif")}
                  alt=""
                  width="56"
                  height="40"
                  class="itinerari-title-arrow mix-blend-screen dark:mix-blend-normal dark:brightness-0 dark:invert"
                  loading="eager"
                  decoding="async"
                />
                {frontmatter.titleParts.to}
              </>
            ) : (
              frontmatter.title
            )
          }
        </Text>
      </div>

        {
          !videoEnModal && (
            <div
              data-aos="fade-up"
              data-aos-duration="1000"
              class="relative overflow-hidden mb-12 w-full"
            >
              {
                frontmatter.video ? (
                  <ItinerariHeroVideo
                    src={withBase(frontmatter.video.publicSrc)}
                    title={frontmatter.video.alt}
                    sound={frontmatter.video.ambSo ?? true}
                    captionsSrc={frontmatter.video.captionsSrc}
                  />
                ) : (
                  <Image
                    width={1000}
                    height={500}
                    src={frontmatter.thumbnail.url}
                    alt={frontmatter.thumbnail.alt}
                    class="w-full object-cover"
                  />
                )
              }
            </div>
          )
        }

      {
        frontmatter.mapa === "sau-tavertet" && (
          <div
            data-aos="fade-up"
            data-aos-duration="1000"
            class="w-full"
          >
            <ItinerariSau />
          </div>
        )
      }

      {
        videoEnModal && frontmatter.video && (
          <ItinerariVideoModal
            modalId={videoModalId}
            label={frontmatter.video.modalLabel ?? "Visualització de la zona"}
            src={frontmatter.video.publicSrc}
            title={frontmatter.video.alt}
            sound={frontmatter.video.ambSo ?? true}
          />
        )
      }
    </Wrapper>

    <Wrapper variant="standard" class={contentWrapperClass}>
      <div
        id="descripcio-recorregut"
        data-aos="fade-up"
        data-aos-duration="1000"
        class="page-text-content grid scroll-mt-28 grid-cols-1 lg:grid-cols-4 items-start gap-x-6 gap-y-2 mb-12"
      >
        <div class="min-w-0">
          <Text
            tag="h2"
            variant="displayMD"
            class="dark:text-white text-base-900 font-medium tracking-tighter capitalize leading-tight break-words"
            >{frontmatter.introLabel ?? "intro"}</Text
          >
        </div>
        <div class="lg:col-span-3 min-w-0">
          {
            introParagraphs.map((p) => (
              <Text
                tag="p"
                variant="textLG"
                class="text-base-500 dark:text-base-400 mb-4 last:mb-0"
              >
                {p}
              </Text>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col border-t border-base-200 dark:border-base-800 mb-12">
        {
          hasRecorregut && (
            <div
              data-aos="fade-up"
              data-aos-duration="1000"
              class="grid grid-cols-1 lg:grid-cols-4 items-start gap-x-6 gap-y-2 py-4 border-b border-base-200 dark:border-base-800"
            >
              <div class="page-text-content min-w-0">
                <Text
                  tag="h2"
                  variant="displayMD"
                  class="dark:text-white text-base-900 font-medium tracking-tighter leading-tight break-words"
                >
                  {frontmatter.recorregutLabel ?? "El recorregut"}
                </Text>
              </div>
              <div class="page-text-content lg:col-span-3 min-w-0">
                {
                  frontmatter.recorregutDescripcio && (
                    <Text
                      tag="p"
                      variant="textXL"
                      class="text-base-500 dark:text-base-400"
                    >
                      {frontmatter.recorregutDescripcio}
                    </Text>
                  )
                }
                <ItinerariDadaIndex
                  items={recorregutItems}
                  ariaLabel={frontmatter.recorregutLabel ?? "El recorregut"}
                />
              </div>
            </div>
          )
        }
        {
          dadesSections.map(([key, value]) => {
            if (key === "mapa" && mapaHref) return null;
            if (key === "mapaGeobotanica") return null;
            const contentIndexItems = frontmatter.dadesIndex?.[key] ?? [];
            const indexItems = contentIndexItems;
            const hasSubModals = indexItems.some((item) => item.modalKey);
            const hasIndex = indexItems.length > 0;
            const modalKey = frontmatter.dadesModalAliases?.[key] ?? key;
            const modal = !hasSubModals
              ? frontmatter.dadesModals?.[modalKey]
              : undefined;
            const label = dadesLabels[key] ?? key;
            const modalId = `itinerari-modal-${modalKey}`;

            return (
              <div
                id={key === "historia" ? "geologia" : undefined}
                data-aos="fade-up"
                data-aos-duration="1000"
                class:list={[
                  "grid grid-cols-1 lg:grid-cols-4 items-start gap-x-6 gap-y-2 py-4 border-b border-base-200 dark:border-base-800",
                  key === "historia" && "scroll-mt-28",
                ]}
              >
                <div class="page-text-content min-w-0">
                {
                  !modal ? (
                    <Text
                      tag="h2"
                      variant="displayMD"
                      class="dark:text-white text-base-900 font-medium tracking-tighter capitalize leading-tight break-words"
                    >
                      {label}
                    </Text>
                  ) : (
                    <TitleIconTrigger
                      data-modal-target={modalId}
                      aria-haspopup="dialog"
                      aria-label={`Obrir informació: ${label}`}
                    >
                      {label}
                    </TitleIconTrigger>
                  )
                }
                </div>
                <div class="page-text-content lg:col-span-3 min-w-0">
                  {
                    key === "historia" && dadesArticle.length > 0 ? (
                      <ItinerariDadesArticle blocks={dadesArticle} />
                    ) : (
                      <Text
                        tag="p"
                        variant="textXL"
                        class="text-base-500 dark:text-base-400 whitespace-pre-line"
                      >
                        {value}
                      </Text>
                    )
                  }
                  {
                    hasIndex &&
                      indexItems &&
                      !(key === "historia" && dadesArticle.length > 0) && (
                      <ItinerariDadaIndex
                        items={indexItems}
                        ariaLabel={`Índex de ${label}`}
                      />
                    )
                  }
                </div>
                {
                  hasIndex && indexItems?.map((item) => {
                    if (!item.modalKey) return null;
                    const subModal = frontmatter.dadesModals?.[item.modalKey];
                    if (!subModal) return null;
                    const subModalId = `itinerari-modal-${item.modalKey}`;

                    return subModal.cronologia && subModal.cronologia.length > 0 ? (
                      <ItinerariCronologiaModal
                        modalId={subModalId}
                        label={item.label}
                        intro={subModal.intro}
                        items={subModal.cronologia}
                        outroMedia={subModal.outroMedia}
                        hideTitle={item.modalKey === "sequencia-geologica-itinerari"}
                      />
                    ) : subModal.videos && subModal.videos.length > 0 ? (
                      <ItinerariPaleogeologiaModal
                        modalId={subModalId}
                        label={item.label}
                        intro={subModal.intro}
                        videos={subModal.videos}
                        sections={subModal.sections}
                      />
                    ) : (
                      <ItinerariDadaModal
                        modalId={subModalId}
                        label={item.label}
                        intro={subModal.intro}
                        introMedia={subModal.introMedia}
                        sections={subModal.sections ?? []}
                        images={subModal.images}
                      />
                    );
                  })
                }
                {
                  modal && modal.videos && modal.videos.length > 0 ? (
                    <ItinerariPaleogeologiaModal
                      modalId={modalId}
                      label={label}
                      intro={modal.intro}
                      videos={modal.videos}
                      sections={modal.sections}
                    />
                  ) : (
                    modal && (
                      <ItinerariDadaModal
                        modalId={modalId}
                        label={label}
                        intro={modal.intro}
                        introMedia={modal.introMedia}
                        sections={modal.sections ?? []}
                        images={modal.images}
                      />
                    )
                  )
                }
              </div>
            );
          })
        }
      </div>

      {
        introTable && (
          <div
            id="parades"
            data-aos="fade-up"
            data-aos-duration="1000"
            class="page-text-content grid scroll-mt-28 grid-cols-1 lg:grid-cols-4 items-start gap-x-6 gap-y-2 mb-12"
          >
            <div class="min-w-0">
              <Text
                tag="h2"
                variant="displayMD"
                class="dark:text-white text-base-900 font-medium tracking-tighter capitalize leading-tight break-words"
              >
                {frontmatter.paradesLabel ?? "Parades"}
              </Text>
            </div>
            <div class="lg:col-span-3 min-w-0">
              <div class="overflow-x-auto">
                <table class="w-full min-w-[480px] border-collapse text-left">
                  <thead>
                    <tr class="border-b border-base-200 dark:border-base-800">
                      {(introTable.headers ?? ["Parada", "Material / formació", "Edat i origen"]).map(
                        (header) => (
                          <th
                            scope="col"
                            class="py-3 pr-4 last:pr-0 text-sm font-medium text-base-900 dark:text-white uppercase tracking-wide"
                          >
                            {header}
                          </th>
                        ),
                      )}
                    </tr>
                  </thead>
                  <tbody>
                    {introTable.rows.map((row) => (
                      <tr class="border-b border-base-200 dark:border-base-800">
                        <td class="py-3 pr-4 text-base font-medium whitespace-nowrap">
                          {row.slug ? (
                            <Text
                              tag="a"
                              href={withBase(`/parades/${row.slug}`)}
                              variant="textBase"
                              class={introParadaLinkClass}
                            >
                              {row.parada}
                            </Text>
                          ) : (
                            <span class="text-base-900 dark:text-white">{row.parada}</span>
                          )}
                        </td>
                        <td class="py-3 pr-4 text-base">
                          {row.slug ? (
                            <Text
                              tag="a"
                              href={withBase(`/parades/${row.slug}`)}
                              variant="textBase"
                              class={`text-base-500 dark:text-base-400 ${introParadaLinkClass}`}
                            >
                              {row.material}
                            </Text>
                          ) : (
                            <span class="text-base-500 dark:text-base-400">{row.material}</span>
                          )}
                        </td>
                        <td class="py-3 text-base text-base-500 dark:text-base-400">
                          {row.edat}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )
      }

      {
        mapesItems.length > 0 && (
          <div
            id="mapes"
            data-aos="fade-up"
            data-aos-duration="1000"
            class="page-text-content grid scroll-mt-28 grid-cols-1 lg:grid-cols-4 items-start gap-x-6 gap-y-2 mb-12"
          >
            <div class="min-w-0">
              <Text
                tag="h2"
                variant="displayMD"
                class="dark:text-white text-base-900 font-medium tracking-tighter leading-tight break-words"
              >
                Mapes interactius i links d'interès
              </Text>
            </div>
            <div class="lg:col-span-3 min-w-0">
              <ItinerariDadaIndex
                items={mapesItems}
                ariaLabel="Mapes interactius i links d'interès"
              />
            </div>
          </div>
        )
      }

      <ItinerariZoom zoomId="itinerari-page">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-12">
          {
            frontmatter.images.map((image) => (
              <div data-aos="fade-up" data-aos-duration="1000" class="min-w-0">
                <button
                  type="button"
                  class="relative z-[1] pointer-events-auto block w-full aspect-square cursor-pointer overflow-hidden border-0 p-0 bg-transparent hover:opacity-90 transition-opacity"
                  data-itinerari-zoom
                  data-alt={image.alt}
                  data-caption={image.caption ?? image.alt}
                  aria-label={`Ampliar: ${image.alt}`}
                >
                  <Image
                    src={image.url}
                    alt={image.alt}
                    width={600}
                    height={600}
                    class="size-full object-cover"
                  />
                </button>
              </div>
            ))
          }
        </div>
      </ItinerariZoom>

      {
        frontmatter.credits && frontmatter.credits.length > 0 && (
          <div
            data-aos="fade-up"
            data-aos-duration="1000"
            class="page-text-content grid grid-cols-1 lg:grid-cols-4 gap-2 mt-12"
          >
            <Text
              tag="h2"
              variant="displayXL"
              class="dark:text-white text-base-900 font-medium tracking-tighter"
              >Equip</Text
            >
            <div class="lg:col-span-3 flex flex-col gap-4">
              {
                frontmatter.credits.map((credit) => (
                  <div class="flex justify-between border-b border-base-200 dark:border-base-800 py-4">
                    <Text
                      tag="p"
                      variant="displaySM"
                      class="dark:text-white font-medium"
                    >
                      {credit.name}
                    </Text>
                    <Text
                      tag="p"
                      variant="textXL"
                      class="text-base-500 dark:text-base-400"
                    >
                      {credit.role}
                    </Text>
                  </div>
                ))
              }
            </div>
          </div>
        )
      }

      <slot />

      <div class="page-text-content">
        <GlossariSection />
      </div>
    </Wrapper>
    </div>

    {
      frontmatter.altimetria && (
        <ItinerariVideoModal
          modalId={altimetriaModalId}
          label={frontmatter.altimetria.label}
          src={frontmatter.altimetria.publicSrc}
          title={frontmatter.altimetria.alt}
          sound={frontmatter.altimetria.ambSo ?? false}
          caption={frontmatter.altimetria.caption}
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .itinerari-title-wrap {
    container-type: inline-size;
  }

  .itinerari-page-title {
    white-space: nowrap;
    font-size: clamp(1.875rem, 7.25cqi, 8rem);
    line-height: 1.05;
  }

  .itinerari-title-from {
    margin-left: 0.65em;
  }

  .itinerari-title-arrow {
    display: inline-block;
    vertical-align: middle;
    height: 0.72em;
    width: auto;
    margin-left: 0.45em;
    margin-right: 0.25em;
  }

  @media (min-width: 1024px) {
    .itinerari-title-from {
      margin-left: 1em;
    }

    .itinerari-title-arrow {
      margin-left: 0.65em;
      height: 0.78em;
    }
  }
</style>
