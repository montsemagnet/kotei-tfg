---
/** Model oficial de pàgina de parada. Referència: I1-P1.md. No substituir per ParadaLayout. */
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ParadaGallery from "@/components/parades/ParadaGallery.astro";
import ItinerariZoom from "@/components/itinerari/ItinerariZoom.astro";
import ItinerariDadaModal from "@/components/itinerari/ItinerariDadaModal.astro";
import ItinerariVideoModal from "@/components/itinerari/ItinerariVideoModal.astro";
import ItinerariModalTextSizeControls from "@/components/itinerari/ItinerariModalTextSizeControls.astro";
import GlossariSection from "@/components/global/GlossariSection.astro";
import { withBase } from "@/utils/withBase";
import { getParadaSlug } from "@/utils/paradaSlug";

const { frontmatter, slug } = Astro.props;
const titolParada = String(frontmatter.title ?? "").replace(/^P\d+\.\s*/i, "");
const icon = (name: string) => withBase(`/images/parades/ui/${name}`);
const pinSrc = frontmatter.pinSrc
  ? withBase(frontmatter.pinSrc)
  : undefined;

const itinerariEntry = await getEntry("itineraris", frontmatter.itinerari);
const itinerariTitle = itinerariEntry?.data.title ?? "Itinerari";
const itinerariHref = withBase(`/itineraris/${frontmatter.itinerari}`);
const paradesItinerari = (await getCollection("parades"))
  .filter((parada) => parada.data.itinerari === frontmatter.itinerari)
  .map((parada) => ({
    slug: getParadaSlug(parada),
    title: parada.data.title,
    ordre: parada.data.ordre,
  }))
  .sort((a, b) => a.ordre - b.ordre);
const currentIndex = paradesItinerari.findIndex((parada) => parada.slug === slug);
const paradaAnterior =
  currentIndex > 0 ? paradesItinerari[currentIndex - 1] : undefined;
const paradaSeguent =
  currentIndex >= 0 && currentIndex < paradesItinerari.length - 1
    ? paradesItinerari[currentIndex + 1]
    : undefined;

const breadcrumbLink =
  "uppercase text-base-500 hover:text-base-900 dark:hover:text-white transition-colors";
const breadcrumbCurrent =
  "uppercase text-base-900 dark:text-white font-medium";
const paradaNavLink =
  "uppercase text-base-500 hover:text-base-900 dark:hover:text-white transition-colors inline-flex items-center gap-1";

const geologiaModalId = `parada-geologia-${slug}`;
const mapaZoomId = `parada-mapa-${slug}`;
const mapaHref = frontmatter.mapaUrl ? withBase(frontmatter.mapaUrl) : undefined;
const mapaLabel = frontmatter.mapaLabel ?? "Mapa";
const mapaDescripcio = frontmatter.mapaDescripcio ?? mapaLabel;
const mapaIsStaticImage = Boolean(
  frontmatter.mapaUrl && /\.(png|jpe?g|webp|gif)$/i.test(frontmatter.mapaUrl),
);
const videoAeriModalId = `parada-aeri-${slug}`;
const videoAeriPoster = frontmatter.videoAeri?.poster
  ? withBase(frontmatter.videoAeri.poster)
  : undefined;
const geologiaResum = String(frontmatter.geologia?.resum ?? "")
  .split(/\n\s*\n/)
  .map((paragraf) => paragraf.trim())
  .filter(Boolean)
  .map((paragraf) =>
    paragraf
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>"),
  );
const hasGeologiaModal = Boolean(
  frontmatter.geologia?.sections?.length ||
    frontmatter.geologia?.parts?.length,
);
const geobotanicaResum =
  frontmatter.geobotanicaText ??
  frontmatter.analisiFlora?.resum ??
  "Contingut de geobotànica de la parada.";
const iconButtonClass =
  "inline-flex size-16 shrink-0 items-center justify-center rounded-2xl border border-base-200 bg-white p-2 shadow-sm transition hover:border-[#1E6B42]/40 hover:shadow-md dark:border-base-700 dark:bg-base-900";
const iconImgClass = "size-10";
---

<BaseLayout pageTitle={frontmatter.title}>
  <section>
    <div data-text-size-enabled>
      <Wrapper variant="standard" class="pt-14 pb-12 lg:pt-16">
        <nav aria-label="Ruta de navegació" class="mb-2">
          <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0">
            <li>
              <Text tag="a" variant="textXS" href={withBase("/")} class={breadcrumbLink}>
                Inici
              </Text>
            </li>
            <li
              class="select-none text-xs uppercase text-base-400 dark:text-base-600"
              aria-hidden="true"
            >
              /
            </li>
            <li>
              <Text
                tag="a"
                variant="textXS"
                href={itinerariHref}
                class={breadcrumbLink}
              >
                {itinerariTitle}
              </Text>
            </li>
            <li
              class="select-none text-xs uppercase text-base-400 dark:text-base-600"
              aria-hidden="true"
            >
              /
            </li>
            <li>
              <Text
                tag="span"
                variant="textXS"
                class={breadcrumbCurrent}
                aria-current="page"
              >
                {frontmatter.title}
              </Text>
            </li>
          </ol>
        </nav>

        <div class="mb-1 flex justify-end">
          <ItinerariModalTextSizeControls label="Mida del text de la parada" />
        </div>

        {
          (paradaAnterior || paradaSeguent) && (
            <nav
              aria-label="Parades de l'itinerari"
              class="mb-3 flex items-center justify-between gap-4"
            >
              <div class="min-w-0">
                {paradaAnterior ? (
                  <Text
                    tag="a"
                    variant="textXS"
                    href={withBase(`/parades/${paradaAnterior.slug}`)}
                    class={paradaNavLink}
                    title={paradaAnterior.title}
                  >
                    <span aria-hidden="true">←</span>
                    <span class="max-w-[12rem] truncate sm:max-w-none">
                      {paradaAnterior.title}
                    </span>
                  </Text>
                ) : (
                  <span class="invisible text-xs" aria-hidden="true">
                    ←
                  </span>
                )}
              </div>
              <div class="min-w-0 text-right">
                {paradaSeguent ? (
                  <Text
                    tag="a"
                    variant="textXS"
                    href={withBase(`/parades/${paradaSeguent.slug}`)}
                    class={`${paradaNavLink} justify-end`}
                    title={paradaSeguent.title}
                  >
                    <span class="max-w-[12rem] truncate sm:max-w-none">
                      {paradaSeguent.title}
                    </span>
                    <span aria-hidden="true">→</span>
                  </Text>
                ) : null}
              </div>
            </nav>
          )
        }

        <div class="grid items-start gap-8 lg:grid-cols-[minmax(16rem,38%)_minmax(0,1fr)] lg:gap-12">
          <div class="flex flex-col gap-8">
            {
              pinSrc && (
                <img
                  src={pinSrc}
                  alt={`Localització de la parada: ${frontmatter.coordenades}`}
                  width="410"
                  height="590"
                  class="mx-auto w-full max-w-[22rem] lg:max-w-none"
                />
              )
            }
            {
              frontmatter.materials?.length > 0 && (
                <section class="text-center lg:text-left">
                  <Text
                    tag="h2"
                    variant="displayMD"
                    class="dark:text-white text-base-900 font-medium tracking-tighter"
                  >
                    Materials
                  </Text>
                  <ul class="mt-4 flex flex-col gap-3">
                    {frontmatter.materials.map((material) => (
                      <li class="text-lg text-base-700 dark:text-base-300">
                        {material.referencia && (
                          <span class="font-medium tabular-nums">
                            {material.referencia}{" "}
                          </span>
                        )}
                        {material.enllaç ? (
                          <a
                            href={withBase(material.enllaç)}
                            class="text-accent-700 underline decoration-accent-700/30 underline-offset-4 transition hover:decoration-accent-700 dark:text-accent-400 dark:decoration-accent-400/40"
                          >
                            {material.nom}
                          </a>
                        ) : (
                          material.nom
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }
          </div>

          <div class="page-text-content flex min-w-0 flex-col gap-8">
            <header class="flex items-start justify-center gap-6 text-center lg:justify-start lg:gap-8 lg:text-left">
              <div class="min-w-0">
                <Text
                  tag="p"
                  variant="textSM"
                  class="mb-2 uppercase tracking-[0.18em] text-[#1E6B42]"
                >
                  Parada
                </Text>
                <Text
                  tag="h1"
                  variant="displayXL"
                  class="dark:text-white text-base-900 font-medium tracking-tighter"
                >
                  {titolParada}
                </Text>
              </div>
              <div class="mt-1 flex shrink-0 flex-col items-center gap-3">
              {
                mapaHref && mapaIsStaticImage ? (
                  <ItinerariZoom zoomId={mapaZoomId}>
                    <button
                      type="button"
                      data-itinerari-zoom
                      data-zoom-badge="off"
                      data-full-src={mapaHref}
                      data-alt={mapaDescripcio}
                      data-caption={mapaDescripcio}
                      class="flex flex-col items-center gap-1 border-0 bg-transparent p-0 text-[#1E6B42] cursor-pointer"
                      title="Obrir el mapa de la parada"
                      aria-label={`Ampliar: ${mapaLabel}`}
                    >
                      <span class={iconButtonClass}>
                        <img src={icon("triptic.png")} alt="" width="48" height="48" class={iconImgClass} />
                      </span>
                      <span class="text-xs font-medium uppercase tracking-[0.16em]">
                        {mapaLabel}
                      </span>
                    </button>
                  </ItinerariZoom>
                ) : mapaHref ? (
                  <a
                    href={mapaHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex flex-col items-center gap-1 text-[#1E6B42] no-underline"
                    title="Obrir el mapa de la parada"
                  >
                    <span class={iconButtonClass}>
                      <img src={icon("triptic.png")} alt="" width="48" height="48" class={iconImgClass} />
                    </span>
                    <span class="text-xs font-medium uppercase tracking-[0.16em]">
                      {mapaLabel}
                    </span>
                  </a>
                ) : (
                  <span class="flex flex-col items-center gap-1 opacity-40" aria-hidden="true">
                    <span class={iconButtonClass}>
                      <img src={icon("triptic.png")} alt="" width="48" height="48" class={iconImgClass} />
                    </span>
                    <span class="text-xs font-medium uppercase tracking-[0.16em] text-[#1E6B42]">
                      Mapa
                    </span>
                  </span>
                )
              }
              {
                frontmatter.videoAeri && videoAeriPoster && (
                  <button
                    type="button"
                    data-video-modal-target={videoAeriModalId}
                    class="flex flex-col items-center gap-1 border-0 bg-transparent p-0 text-[#1E6B42] cursor-pointer"
                    title={frontmatter.videoAeri.modalLabel ?? "Obrir el vídeo aeri"}
                    aria-haspopup="dialog"
                    aria-label={`Obrir: ${frontmatter.videoAeri.modalLabel ?? "Vista aèria de la parada"}`}
                  >
                    <span class="relative size-16 overflow-hidden rounded-2xl border border-base-200 bg-white shadow-sm transition hover:border-[#1E6B42]/40 hover:shadow-md dark:border-base-700 dark:bg-base-900">
                      <img
                        src={videoAeriPoster}
                        alt=""
                        width="64"
                        height="64"
                        class="size-full object-cover"
                      />
                      <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/30">
                        <svg
                          class="size-5 text-white drop-shadow"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M8 5.14v13.72L19 12 8 5.14z" />
                        </svg>
                      </span>
                    </span>
                    <span class="text-xs font-medium uppercase tracking-[0.16em]">
                      Vídeo
                    </span>
                  </button>
                )
              }
              </div>
            </header>

            <section class="mt-12 lg:mt-20">
              <h2 class="flex items-center gap-3">
                <span class={iconButtonClass} aria-hidden="true">
                  <img
                    src={icon("martell.png")}
                    alt=""
                    width="102"
                    height="93"
                    class={iconImgClass}
                  />
                </span>
                <Text
                  tag="span"
                  variant="displayMD"
                  class="dark:text-white text-base-900 font-medium tracking-tighter"
                >
                  Geologia
                </Text>
              </h2>
              <div class="mt-4 space-y-4 text-lg leading-relaxed text-base-500 dark:text-base-400 md:text-xl">
                {geologiaResum.map((paragraf) => (
                  <p set:html={paragraf} />
                ))}
              </div>
              {
                hasGeologiaModal && (
                  <p class="mt-5">
                    <button
                      type="button"
                      data-modal-target={geologiaModalId}
                      class="text-lg text-accent-700 underline decoration-accent-700/30 underline-offset-4 transition hover:decoration-accent-700 dark:text-accent-400 dark:decoration-accent-400/40"
                      aria-haspopup="dialog"
                    >
                      Mode investigador: ON
                    </button>
                  </p>
                )
              }
            </section>

            {
              (frontmatter.geobotanicaText || frontmatter.analisiFlora?.resum) && (
            <section>
              <h2 class="flex items-center gap-3">
                <span class={iconButtonClass} aria-hidden="true">
                  <img
                    src={icon("fulla.png")}
                    alt=""
                    width="102"
                    height="93"
                    class={iconImgClass}
                  />
                </span>
                <Text
                  tag="span"
                  variant="displayMD"
                  class="dark:text-white text-base-900 font-medium tracking-tighter"
                >
                  Geobotànica
                </Text>
              </h2>
              <Text
                tag="p"
                variant="textLG"
                class="mt-4 text-base-500 dark:text-base-400"
              >
                {geobotanicaResum}
              </Text>
            </section>
              )
            }
          </div>
        </div>

        {
          frontmatter.fotos && frontmatter.fotos.length > 0 && (
            <div class="mt-10 border-t border-base-200 pt-6 dark:border-base-800">
              <ParadaGallery fotos={frontmatter.fotos} galleryId={slug} />
            </div>
          )
        }

        <div class="page-text-content mt-12">
          <GlossariSection descriptionVariant="textLG" />
        </div>
      </Wrapper>
    </div>

    {
      hasGeologiaModal && (
        <ItinerariDadaModal
          modalId={geologiaModalId}
          label={
            frontmatter.geologia.modalLabel ??
            `Geologia — ${frontmatter.title}`
          }
          intro={frontmatter.geologia.intro}
          introMedia={frontmatter.geologia.introMedia}
          sections={frontmatter.geologia.sections ?? []}
        />
      )
    }
    {
      frontmatter.videoAeri && (
        <ItinerariVideoModal
          modalId={videoAeriModalId}
          label={frontmatter.videoAeri.modalLabel ?? "Vista aèria de la parada"}
          src={frontmatter.videoAeri.publicSrc}
          title={frontmatter.videoAeri.alt}
          sound={frontmatter.videoAeri.ambSo ?? true}
          allowFullscreen
          holdLastFrame
        />
      )
    }
    <slot />
  </section>
</BaseLayout>
