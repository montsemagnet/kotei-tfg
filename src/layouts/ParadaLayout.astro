---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import TitleIconTrigger from "@/components/fundations/elements/TitleIconTrigger.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ParadaMedia from "@/components/parades/ParadaMedia.astro";
import ParadaGallery from "@/components/parades/ParadaGallery.astro";
import ParadaAnalisiFloraModal from "@/components/parades/ParadaAnalisiFloraModal.astro";
import ItinerariDadaModal from "@/components/itinerari/ItinerariDadaModal.astro";
import ItinerariDadaIndex from "@/components/itinerari/ItinerariDadaIndex.astro";
import ItinerariVideoModal from "@/components/itinerari/ItinerariVideoModal.astro";
import ItinerariModalTextSizeControls from "@/components/itinerari/ItinerariModalTextSizeControls.astro";
import GlossariSection from "@/components/global/GlossariSection.astro";
import { withBase } from "@/utils/withBase";
import { getParadaSlug } from "@/utils/paradaSlug";

const { frontmatter, slug } = Astro.props;
const analisiFloraModalId = `parada-flora-${slug}`;
const geologiaModalId = `parada-geologia-${slug}`;
const geologiaParts = frontmatter.geologia?.parts ?? [];
const hasGeologiaParts = geologiaParts.length > 0;
const videoAeriModalId = `parada-aeri-${slug}`;

const itinerariEntry = await getEntry("itineraris", frontmatter.itinerari);
const itinerariTitle = itinerariEntry?.data.title ?? "Itinerari";
const itinerariHref = withBase(`/itineraris/${frontmatter.itinerari}`);
const mapaHref = frontmatter.mapaUrl ? withBase(frontmatter.mapaUrl) : undefined;
const mapaLabel = frontmatter.mapaLabel ?? "Mapa QGIS";
const mapaDescripcio =
  frontmatter.mapaDescripcio ?? frontmatter.mapaUrl;
const mapaTitleAttr =
  mapaLabel === "Mapa QGIS"
    ? "Obrir mapa interactiu fet amb QGIS (nova pestanya)"
    : `Obrir ${mapaLabel.toLowerCase()} (nova pestanya)`;

const paradesItinerari = (await getCollection("parades"))
  .filter((entry) => entry.data.itinerari === frontmatter.itinerari)
  .map((entry) => ({
    slug: getParadaSlug(entry),
    title: entry.data.title,
    ordre: entry.data.ordre,
  }))
  .sort((a, b) => a.ordre - b.ordre);

const currentIndex = paradesItinerari.findIndex((p) => p.slug === slug);
const paradaAnterior =
  currentIndex > 0 ? paradesItinerari[currentIndex - 1] : undefined;
const paradaSeguent =
  currentIndex >= 0 && currentIndex < paradesItinerari.length - 1
    ? paradesItinerari[currentIndex + 1]
    : undefined;

const breadcrumbLink =
  "uppercase text-base-500 hover:text-base-900 dark:hover:text-white transition-colors";
const breadcrumbCurrent =
  "uppercase text-base-900 dark:text-white font-medium";
const paradaNavLink =
  "uppercase text-base-500 hover:text-base-900 dark:hover:text-white transition-colors inline-flex items-center gap-1";

const sectionGrid =
  "grid grid-cols-1 lg:grid-cols-4 gap-3 lg:gap-8 items-start";
const sectionLabel =
  "dark:text-white text-base-900 font-medium tracking-tighter lg:max-w-full";
const sectionContent = "lg:col-span-3 min-w-0 w-full";
---

<BaseLayout pageTitle={frontmatter.title}>
  <section>
    <div data-text-size-enabled>
    <Wrapper variant="standard" class="py-24 lg:py-48">
      <nav aria-label="Ruta de navegació" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 list-none p-0 m-0">
          <li>
            <Text tag="a" variant="textXS" href={withBase("/")} class={breadcrumbLink}>
              Inici
            </Text>
          </li>
          <li
            class="text-base-400 dark:text-base-600 uppercase text-xs select-none"
            aria-hidden="true"
          >
            /
          </li>
          <li>
            <Text
              tag="a"
              variant="textXS"
              href={itinerariHref}
              class={breadcrumbLink}
            >
              {itinerariTitle}
            </Text>
          </li>
          <li
            class="text-base-400 dark:text-base-600 uppercase text-xs select-none"
            aria-hidden="true"
          >
            /
          </li>
          <li>
            <Text
              tag="span"
              variant="textXS"
              class={breadcrumbCurrent}
              aria-current="page"
            >
              {frontmatter.title}
            </Text>
          </li>
        </ol>
      </nav>

      <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
        <Text
          tag="h1"
          variant="display3XL"
          class="dark:text-white text-base-900 font-medium tracking-tighter min-w-0 flex-1"
        >
          {frontmatter.title}
        </Text>
        <ItinerariModalTextSizeControls label="Mida del text de la parada" />
      </div>

      {
        (paradaAnterior || paradaSeguent) && (
          <nav
            aria-label="Parades de l'itinerari"
            class="mb-8 flex items-center justify-between gap-4"
          >
            <div class="min-w-0">
              {
                paradaAnterior ? (
                  <Text
                    tag="a"
                    variant="textXS"
                    href={withBase(`/parades/${paradaAnterior.slug}`)}
                    class={paradaNavLink}
                    title={paradaAnterior.title}
                  >
                    <span aria-hidden="true">←</span>
                    <span class="truncate max-w-[12rem] sm:max-w-none">
                      {paradaAnterior.title}
                    </span>
                  </Text>
                ) : (
                  <span class="invisible text-xs" aria-hidden="true">
                    ←
                  </span>
                )
              }
            </div>
            <div class="min-w-0 text-right">
              {
                paradaSeguent ? (
                  <Text
                    tag="a"
                    variant="textXS"
                    href={withBase(`/parades/${paradaSeguent.slug}`)}
                    class={`${paradaNavLink} justify-end`}
                    title={paradaSeguent.title}
                  >
                    <span class="truncate max-w-[12rem] sm:max-w-none">
                      {paradaSeguent.title}
                    </span>
                    <span aria-hidden="true">→</span>
                  </Text>
                ) : null
              }
            </div>
          </nav>
        )
      }

      <ParadaMedia media={frontmatter.media} />

      {
        frontmatter.videoAeri && (
          <div class="mt-8 max-w-4xl">
            <TitleIconTrigger
              data-video-modal-target={videoAeriModalId}
              aria-haspopup="dialog"
              aria-label={`Obrir: ${frontmatter.videoAeri.modalLabel ?? "Vista aèria de la parada"}`}
            >
              {frontmatter.videoAeri.modalLabel ?? "Vista aèria de la parada"}
            </TitleIconTrigger>
          </div>
        )
      }

      <div class="page-text-content">
      <div
        data-aos="fade-up"
        data-aos-duration="1000"
        class:list={[sectionGrid, "mt-8 border-t border-base-200 dark:border-base-800 pt-8"]}
      >
        <Text tag="h2" variant="displayMD" class={sectionLabel}>
          Coordenades
        </Text>
        <div class={sectionContent}>
          <Text
            tag="p"
            variant="textXL"
            class="text-base-500 dark:text-base-400 font-mono break-words"
          >
            {frontmatter.coordenades}
          </Text>
        </div>
      </div>

      {
        mapaHref && (
          <div
            data-aos="fade-up"
            data-aos-duration="1000"
            class:list={[sectionGrid, "mt-8 border-t border-base-200 dark:border-base-800 pt-8"]}
          >
            <div class="min-w-0">
              <TitleIconTrigger
                as="a"
                href={mapaHref}
                target="_blank"
                rel="noopener noreferrer"
                title={mapaTitleAttr}
                aria-label={`Obrir: ${mapaLabel}`}
                titleClass="!normal-case"
              >
                {mapaLabel}
              </TitleIconTrigger>
            </div>
            <Text
              tag="a"
              variant="textXL"
              href={mapaHref}
              target="_blank"
              rel="noopener noreferrer"
              title={mapaTitleAttr}
              class:list={[
                sectionContent,
                "text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400 transition-colors",
              ]}
            >
              {mapaDescripcio}
            </Text>
          </div>
        )
      }
      </div>
    </Wrapper>

    <Wrapper variant="standard" class="py-8 border-t border-base-200 dark:border-base-800">
      <div
        data-aos="fade-up"
        data-aos-duration="1000"
        class:list={[sectionGrid, "mb-12"]}
      >
        <div class="page-text-content min-w-0">
          <Text tag="h2" variant="displayMD" class={sectionLabel}>
            Alflorament
          </Text>
        </div>
        <div class={sectionContent}>
          <ParadaGallery fotos={frontmatter.fotos} galleryId={slug} />
        </div>
      </div>

      <div
        data-aos="fade-up"
        data-aos-duration="1000"
        class:list={[sectionGrid, "page-text-content mb-12 border-t border-base-200 dark:border-base-800 pt-8"]}
      >
        {
          frontmatter.geologia && hasGeologiaParts ? (
            <>
              <Text tag="h2" variant="displayMD" class={sectionLabel}>
                Geologia
              </Text>
              <div class:list={[sectionContent, "min-w-0"]}>
                {frontmatter.geologia.resum && (
                  <Text
                    tag="p"
                    variant="textXL"
                    class="text-base-500 dark:text-base-400"
                  >
                    {frontmatter.geologia.resum}
                  </Text>
                )}
                <ItinerariDadaIndex
                  ariaLabel="Índex de geologia"
                  modalIdPrefix={`${geologiaModalId}-`}
                  items={geologiaParts.map((part, partIndex) => ({
                    label: part.label,
                    modalKey: String(partIndex),
                  }))}
                />
              </div>
            </>
          ) : frontmatter.geologia ? (
            <>
              <div class="min-w-0">
                <TitleIconTrigger
                  data-modal-target={geologiaModalId}
                  aria-haspopup="dialog"
                  aria-label="Obrir geologia"
                >
                  Geologia
                </TitleIconTrigger>
              </div>
              <Text
                tag="p"
                variant="textXL"
                class:list={[sectionContent, "text-base-500 dark:text-base-400"]}
              >
                {frontmatter.geologia.resum ?? frontmatter.title}
              </Text>
            </>
          ) : (
            <>
              <Text tag="h2" variant="displayMD" class={sectionLabel}>
                Geologia
              </Text>
              <Wrapper variant="prose" class:list={[sectionContent, "-mt-2"]}>
                <slot />
              </Wrapper>
            </>
          )
        }
      </div>
      {
        frontmatter.materials.length > 0 && (
          <div
            data-aos="fade-up"
            data-aos-duration="1000"
            class:list={[sectionGrid, "page-text-content mb-12 border-t border-base-200 dark:border-base-800 pt-8"]}
          >
            <Text tag="h2" variant="displayMD" class={sectionLabel}>
              Materials
            </Text>
            <ul class:list={[sectionContent, "flex flex-col gap-3"]}>
              {frontmatter.materials.map((material) => (
                <li class="border-b border-base-200 dark:border-base-800 pb-3">
                  <Text
                    tag="a"
                    variant="textXL"
                    href={withBase(material.enllaç)}
                    class="text-base-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400"
                  >
                    {material.nom} →
                  </Text>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div
        data-aos="fade-up"
        data-aos-duration="1000"
        class:list={[sectionGrid, "page-text-content border-t border-base-200 dark:border-base-800 pt-8"]}
      >
        {
          frontmatter.geobotanicaText ? (
            <>
              <Text tag="h2" variant="displayMD" class={sectionLabel}>
                Geobotànica
              </Text>
              <Text
                tag="p"
                variant="textXL"
                class:list={[sectionContent, "text-base-500 dark:text-base-400"]}
              >
                {frontmatter.geobotanicaText}
              </Text>
            </>
          ) : frontmatter.analisiFlora ? (
            <>
              <div class="min-w-0">
                <TitleIconTrigger
                  data-modal-target={analisiFloraModalId}
                  aria-haspopup="dialog"
                  aria-label="Obrir geobotànica"
                >
                  Geobotànica
                </TitleIconTrigger>
              </div>
              <Text
                tag="p"
                variant="textXL"
                class:list={[sectionContent, "text-base-500 dark:text-base-400"]}
              >
                {frontmatter.analisiFlora.resum ??
                  frontmatter.analisiFlora.nomCodi}
              </Text>
            </>
          ) : (
            <>
              <Text tag="h2" variant="displayMD" class={sectionLabel}>
                Geobotànica
              </Text>
              <div class={sectionContent}>
                {
                  frontmatter.paisatgeUrl ? (
                    <Text
                      tag="a"
                      variant="textXL"
                      href={withBase(frontmatter.paisatgeUrl)}
                      class="inline-flex items-center gap-2 text-accent-600 dark:text-accent-400 hover:underline"
                    >
                      Veure l'anàlisi botànica i del paisatge →
                    </Text>
                  ) : (
                    <Text
                      tag="p"
                      variant="textXL"
                      class="text-base-500 dark:text-base-400"
                    >
                      Contingut en preparació.
                    </Text>
                  )
                }
              </div>
            </>
          )
        }
      </div>

      <div class="page-text-content">
        <GlossariSection descriptionVariant="textXL" />
      </div>
    </Wrapper>
    </div>

    {
      frontmatter.geologia &&
        hasGeologiaParts &&
        geologiaParts.map((part, partIndex) => (
          <ItinerariDadaModal
            modalId={`${geologiaModalId}-${partIndex}`}
            label={part.modalLabel ?? `${part.label} — ${frontmatter.title}`}
            intro={part.intro}
            sections={part.sections ?? []}
          />
        ))
    }
    {
      frontmatter.geologia && !hasGeologiaParts && (
        <ItinerariDadaModal
          modalId={geologiaModalId}
          label={`Geologia — ${frontmatter.title}`}
          intro={frontmatter.geologia.intro}
          sections={frontmatter.geologia.sections ?? []}
        />
      )
    }
    {
      frontmatter.analisiFlora && (
        <ParadaAnalisiFloraModal
          modalId={analisiFloraModalId}
          data={frontmatter.analisiFlora}
        />
      )
    }
    {
      frontmatter.videoAeri && (
        <ItinerariVideoModal
          modalId={videoAeriModalId}
          label={frontmatter.videoAeri.modalLabel ?? "Vista aèria de la parada"}
          src={frontmatter.videoAeri.publicSrc}
          title={frontmatter.videoAeri.alt}
          sound={frontmatter.videoAeri.ambSo ?? true}
          allowFullscreen
        />
      )
    }
  </section>
</BaseLayout>
