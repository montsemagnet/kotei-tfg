---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroProva from "@/components/landing/HeroProva.astro";
import Philosphy from "@/components/landing/Philosphy.astro";
import HowWeWork from "@/components/landing/HowWeWork.astro";
import Team from "@/components/landing/Team.astro";
import ItinerariZoom from "@/components/itinerari/ItinerariZoom.astro";
import { withBase } from "@/utils/withBase";

const illustrationVerdSrc = withBase("/images/landing/verd-retocat.webp");
const illustrationFonsBlancSrc = withBase("/images/landing/claudia-fonsblanc.webp");
const illustrationAlt =
  "Il·lustració del Grau de Biologia, amb fauna i flora, de Claudia Márquez Ortega.";
const illustrationCaption =
  "Il·lustració de Claudia Márquez Ortega, biòloga i il·lustradora. Cedida per a aquesta web. Els drets de la imatge són seus.";
const illustrationThumbClass = "block h-auto w-full object-contain";
const illustrationZoomButtonClass =
  "mx-auto block w-full max-w-4xl cursor-pointer border-0 bg-transparent p-0";

const provaPhilosophy = [
  {
    title: "Itineraris de camp",
    description:
      "Recorreguts biològics per preparar i ampliar les sortides pràctiques de la Facultat de Biologia (UVic-UCC).",
  },
  {
    title: "Parades interpretatives",
    description:
      "Punts específics de cada itinerari on s'explica el context biològic i els principals elements d'interès de cada indret.",
  },
  {
    title: "Cartografia amb QGIS",
    description:
      "Mapes temàtics per visualitzar la geologia, la vegetació i la distribució espacial dels punts d’estudi.",
  },
  {
    title: "Suport a l'aprenentatge",
    description:
      "Un recurs digital pensat perquè l'alumnat pugui estudiar i revisar els continguts de les sortides de camp.",
  },
  {
    title: "Inclusió i accessibilitat",
    description:
      "Aquest recurs digital amplia l'accés als continguts de camp i facilita el seguiment de l'assignatura a l'alumnat que no pot participar en les sortides. També incorpora recursos per a persones amb discapacitat visual — text alternatiu a imatges, navegació per teclat, augment de mida del text als modals i alternatives textuals al mapa interactiu — i auditiva — subtítols als vídeos narrats.",
  },
  {
    title: "Compromís amb els ODS",
    descriptionBefore: "El projecte s'alinea amb els ",
    descriptionLink: {
      text: "Objectius de Desenvolupament Sostenible",
      url: "https://www.un.org/sustainabledevelopment/es/",
    },
    descriptionAfter:
      ", especialment amb l'ODS 4 (Educació de qualitat), en oferir materials docents accessibles i ben estructurats; amb l'ODS 10 (Reducció de les desigualtats), en proporcionar alternatives digitals per a l'aprenentatge de camp; i amb l'ODS 15 (Vida terrestre), en promoure la comprensió de la geologia, la vegetació i la conservació dels ecosistemes terrestres.",
  },
];
---

<BaseLayout
  description="Itineraris biològics de camp UVic-UCC amb il·lustració de Claudia Márquez Ortega, mapes QGIS i recursos per a l'aprenentatge."
>
  <div data-text-size-enabled>
    <HeroProva hideIllustration lletraVerda />
    <section
      class="relative w-full bg-[#1F321E] dark:bg-base-950"
      aria-label="Il·lustració de Claudia Márquez Ortega"
    >
      <ItinerariZoom zoomId="inici-illustration">
        <figure class="w-full bg-transparent">
          <button
            type="button"
            class:list={[illustrationZoomButtonClass, "dark:hidden"]}
            data-itinerari-zoom
            data-full-src={illustrationVerdSrc}
            data-alt={illustrationAlt}
            data-caption={illustrationCaption}
            aria-label={`Ampliar il·lustració: ${illustrationAlt}`}
          >
            <img
              src={illustrationVerdSrc}
              alt={illustrationAlt}
              width="2400"
              height="3000"
              decoding="async"
              fetchpriority="high"
              class={illustrationThumbClass}
            />
          </button>
          <button
            type="button"
            class:list={[illustrationZoomButtonClass, "hidden dark:block"]}
            data-itinerari-zoom
            data-full-src={illustrationFonsBlancSrc}
            data-alt={illustrationAlt}
            data-caption={illustrationCaption}
            aria-label={`Ampliar il·lustració: ${illustrationAlt}`}
          >
            <img
              src={illustrationFonsBlancSrc}
              alt={illustrationAlt}
              width="2200"
              height="2750"
              decoding="async"
              fetchpriority="high"
              class={illustrationThumbClass}
            />
          </button>
          <figcaption
            class="px-8 lg:px-24 pb-6 pt-3 text-center text-sm font-medium leading-relaxed tracking-tight text-[#c4b4a0] dark:text-base-400"
          >
            <span class="block">
              Il·lustració de <span class="font-semibold">Claudia Márquez Ortega</span>,
              biòloga i il·lustradora.
            </span>
            <span class="mt-1 block">
              Cedida per a aquesta web. Els drets de la imatge són seus.
              {" "}
              <a
                href={withBase("/credits")}
                class="underline decoration-white/40 underline-offset-[3px] hover:decoration-white"
              >
                Crèdits
              </a>
            </span>
          </figcaption>
        </figure>
      </ItinerariZoom>
    </section>
    <div class="page-text-content">
      <div id="que-hi-trobaras" class="scroll-mt-24">
        <Philosphy items={provaPhilosophy} />
      </div>
      <HowWeWork quote="Llegir el paisatge i qui l'habita és entendre com la Terra escriu la història de la vida, des dels minerals i els seus orígens estel·lars fins als models ecològics." />
      <div id="equip" class="scroll-mt-24">
        <Team />
      </div>
    </div>
  </div>
</BaseLayout>
