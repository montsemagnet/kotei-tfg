---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { manualParts } from "@/data/manual-parts";
import { withBase } from "@/utils/withBase";
---

<BaseLayout
  pageTitle="Manual d'incorporació d'un nou itinerari"
  description="Guia per al professorat i al departament de sistemes per incorporar itineraris de camp de biologia a GeoTransectes UVic."
>
  <section>
    <Wrapper variant="standard" class="py-24 lg:py-32 max-w-4xl">
      <Text
        tag="h1"
        variant="displayXL"
        class="dark:text-white text-base-900 font-medium tracking-tighter"
      >
        Manual d'incorporació d'un nou itinerari a la web
      </Text>

      <Text
        tag="p"
        variant="textLG"
        class="mt-4 text-base-600 dark:text-base-400 leading-relaxed text-pretty"
      >
        Aquest lloc web forma part d’un treball de fi de grau (TFG) elaborat com
        a plataforma per publicar itineraris de camp de biologia (geològics,
        botànics, zoològics, etc.) per tal de preservar i organitzar el
        coneixement i fer-lo més accessible. El codi s’ha cedit a la universitat
        i s’ha dissenyat perquè sigui reutilitzable: el professorat pot preparar
        els seus continguts i, amb el suport del departament de sistemes,
        incorporar nous itineraris, parades i materials sense haver de construir
        una web des de zero.
      </Text>

      <nav aria-label="Parts del manual" class="mt-10">
        <ul class="grid gap-4 list-none p-0 m-0 sm:grid-cols-2">
          {
            manualParts.map((part, index) => (
              <li>
                <a
                  href={withBase(`/manual/${part.slug}/`)}
                  class="block h-full rounded-lg border border-base-200 dark:border-base-700 bg-base-50 dark:bg-base-800/50 p-5 hover:border-accent-500 dark:hover:border-accent-400 duration-300"
                >
                  <span class="text-xs font-medium uppercase tracking-wide text-accent-700 dark:text-accent-400">
                    {index + 1}
                  </span>
                  <Text
                    tag="h2"
                    variant="textLG"
                    class="mt-2 font-medium text-base-900 dark:text-white"
                  >
                    {part.title}
                  </Text>
                  <p class="mt-2 text-sm text-base-600 dark:text-base-400 leading-relaxed">
                    {part.description}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-16 pt-8 border-t border-base-200 dark:border-base-800">
        <Text
          tag="h2"
          variant="textSM"
          class="font-medium uppercase tracking-wide text-base-900 dark:text-white"
        >
          Contacte i suport
        </Text>
        <p class="mt-3 text-base text-base-700 dark:text-base-300 leading-relaxed">
          <strong class="text-base-900 dark:text-white">Montserrat Magnet Sabata</strong>
          {" — "}
          <a
            href="mailto:mariamontserrat.magnet@uvic.cat"
            class="text-accent-700 dark:text-accent-400 underline decoration-accent-700/30 dark:decoration-accent-400/40 underline-offset-[3px] hover:decoration-accent-700 dark:hover:decoration-accent-400"
          >
            mariamontserrat.magnet@uvic.cat
          </a>
        </p>
        <p class="mt-2 text-sm text-base-600 dark:text-base-400">
          Abast del suport: només peticions de professorat universitari i/o del
          servei d’informàtica de la UVic.
        </p>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
