---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ItinerariModalTextSizeControls from "@/components/itinerari/ItinerariModalTextSizeControls.astro";
import { Content, getHeadings } from "./_content.md";
import { withBase } from "@/utils/withBase";

const headings = getHeadings().filter((h) => h.depth === 2);
---

<BaseLayout
  pageTitle="Manual de reutilització"
  description="Guia pràctica per afegir itineraris, parades i materials a GeoTransectes UVic sense ser especialista en Astro."
>
  <section>
    <Wrapper variant="standard" class="py-24 lg:py-32 max-w-4xl">
      <div data-text-size-enabled>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <Text
            tag="h1"
            variant="displayXL"
            class="dark:text-white text-base-900 font-medium tracking-tighter min-w-0 flex-1"
          >
            Manual de reutilització
          </Text>
          <ItinerariModalTextSizeControls label="Mida del text del manual" />
        </div>

        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-600 dark:text-base-400 leading-relaxed text-pretty itinerari-modal-text-content"
        >
          Part A: professorat (quin contingut preparar i com
          entregar-lo). Part B: informàtica (integrar i publicar).
          La publicació no és oberta al professorat.
        </Text>

        {
          headings.length > 0 && (
            <nav
              aria-label="Contingut del manual"
              class="mt-10 rounded-lg border border-base-200 dark:border-base-700 bg-base-50 dark:bg-base-800/50 p-5"
            >
              <Text
                tag="h2"
                variant="textSM"
                class="font-medium uppercase tracking-wide text-base-900 dark:text-white"
              >
                Contingut
              </Text>
              <ol class="mt-3 space-y-2 list-decimal list-inside">
                {headings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="text-sm text-base-700 dark:text-base-300 hover:text-accent-500 dark:hover:text-accent-300 duration-300"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <Wrapper
          variant="prose"
          class="mt-12 itinerari-modal-text-content manual-prose"
        >
          <Content />
        </Wrapper>

        <p class="mt-16 text-sm text-base-500 dark:text-base-400">
          <a
            href={withBase("/credits")}
            class="underline underline-offset-2 hover:text-accent-500 dark:hover:text-accent-300"
          >
            Crèdits i llicències
          </a>
          {" · "}
          Font editable al repositori:
          <code class="text-xs">src/pages/manual/_content.md</code>
        </p>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<style>
  .manual-prose :global(pre) {
    overflow-x: auto;
  }
  .manual-prose :global(table) {
    display: block;
    overflow-x: auto;
  }
</style>
