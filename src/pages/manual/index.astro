---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ItinerariModalTextSizeControls from "@/components/itinerari/ItinerariModalTextSizeControls.astro";
import { Content, getHeadings } from "./_content.md";

const headings = getHeadings().filter((h) => h.depth === 2);

type TocItem =
  | { kind: "part"; heading: (typeof headings)[number] }
  | { kind: "step"; heading: (typeof headings)[number]; n: number }
  | { kind: "item"; heading: (typeof headings)[number] };

const tocItems: TocItem[] = [];
let inFirstPart = false;
let firstPartStep = 0;

for (const heading of headings) {
  if (heading.text.startsWith("PRIMERA PART")) {
    inFirstPart = true;
    firstPartStep = 0;
    tocItems.push({ kind: "part", heading });
    continue;
  }
  if (heading.text.startsWith("SEGONA PART")) {
    inFirstPart = false;
    tocItems.push({ kind: "part", heading });
    continue;
  }
  if (inFirstPart) {
    firstPartStep += 1;
    tocItems.push({ kind: "step", heading, n: firstPartStep });
    continue;
  }
  tocItems.push({ kind: "item", heading });
}
---

<BaseLayout
  pageTitle="Manual d'incorporació d'un nou itinerari"
  description="Guia per al professorat i al departament de sistemes per incorporar itineraris de camp de biologia a GeoTransectes UVic."
>
  <section>
    <Wrapper variant="standard" class="py-24 lg:py-32 max-w-4xl">
      <div data-text-size-enabled>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <Text
            tag="h1"
            variant="displayXL"
            class="dark:text-white text-base-900 font-medium tracking-tighter min-w-0 flex-1"
          >
            Manual d'incorporació d'un nou itinerari a la web
          </Text>
          <ItinerariModalTextSizeControls label="Mida del text del manual" />
        </div>

        <Text
          tag="p"
          variant="textLG"
          class="mt-4 text-base-600 dark:text-base-400 leading-relaxed text-pretty itinerari-modal-text-content"
        >
          Aquest lloc web forma part d’un treball de fi de grau (TFG) elaborat
          com a plataforma per publicar itineraris de camp de biologia
          (geològics, botànics, zoològics, etc.) per tal de preservar i
          organitzar el coneixement i fer-lo més accessible. El codi s’ha cedit
          a la universitat i s’ha dissenyat perquè sigui reutilitzable: el
          professorat pot preparar els seus continguts i, amb el suport del
          departament de sistemes, incorporar nous itineraris, parades i
          materials sense haver de construir una web des de zero.
        </Text>

        {
          headings.length > 0 && (
            <nav
              aria-label="Contingut del manual"
              class="mt-10 rounded-lg border border-base-200 dark:border-base-700 bg-base-50 dark:bg-base-800/50 p-5"
            >
              <Text
                tag="h2"
                variant="textSM"
                class="font-medium uppercase tracking-wide text-base-900 dark:text-white"
              >
                Contingut
              </Text>
              <ul class="mt-3 space-y-2 list-none p-0 text-base">
                {tocItems.map((item) => (
                  <li
                    class={
                      item.kind === "part"
                        ? "mt-3 first:mt-0 font-medium text-base-900 dark:text-white"
                        : "pl-4"
                    }
                  >
                    <a
                      href={`#${item.heading.slug}`}
                      class="text-base text-base-700 dark:text-base-300 hover:text-accent-500 dark:hover:text-accent-300 duration-300"
                    >
                      {item.kind === "step"
                        ? `${item.n}. ${item.heading.text}`
                        : item.heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <Wrapper
          variant="prose"
          class="mt-12 itinerari-modal-text-content manual-prose prose-lg"
        >
          <Content />
        </Wrapper>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<style>
  .manual-prose {
    font-size: 1.125rem;
    line-height: 1.8;
  }
  .manual-prose :global(pre) {
    overflow-x: auto;
    font-size: 0.95em;
    color: #f3f4f6;
    background-color: #111827;
  }
  .manual-prose :global(pre code) {
    color: inherit;
    background-color: transparent;
  }
  .manual-prose :global(table) {
    display: block;
    overflow-x: auto;
    font-size: 1em;
  }
  .manual-prose :global(h2) {
    font-size: 1.5em;
  }
  .manual-prose :global(h3) {
    font-size: 1.25em;
  }
  .manual-prose :global(h4) {
    font-size: 1.125em;
  }
</style>
