---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ParadaGallery from "@/components/parades/ParadaGallery.astro";
import ParadaAnalisiFloraModal from "@/components/parades/ParadaAnalisiFloraModal.astro";
import ItinerariDadaModal from "@/components/itinerari/ItinerariDadaModal.astro";
import ItinerariDadaIndex from "@/components/itinerari/ItinerariDadaIndex.astro";
import ItinerariModalHeaderActions from "@/components/itinerari/ItinerariModalHeaderActions.astro";
import ItinerariVideoModal from "@/components/itinerari/ItinerariVideoModal.astro";
import ItinerariModalTextSizeControls from "@/components/itinerari/ItinerariModalTextSizeControls.astro";
import { withBase } from "@/utils/withBase";
import { findParadaBySlug, getParadaSlug } from "@/utils/paradaSlug";

const entry = await findParadaBySlug("I1-P1");
if (!entry) throw new Error("No s'ha trobat la parada I1-P1 per a la prova de disseny.");

const frontmatter = entry.data;
const slug = getParadaSlug(entry);
const icon = (name: string) => withBase(`/images/proves/parada-disseny/${name}`);

const geologiaModalId = `prova-geologia-${slug}`;
const geologiaIndexModalId = `${geologiaModalId}-index`;
const geologiaParts = frontmatter.geologia?.parts ?? [];
const hasGeologiaParts = geologiaParts.length > 0;
const analisiFloraModalId = `prova-flora-${slug}`;
const videoAeriModalId = `prova-aeri-${slug}`;
const mapaHref = frontmatter.mapaUrl ? withBase(frontmatter.mapaUrl) : undefined;
const paginaActualHref = withBase(`/parades/${slug}`);
const iconButtonClass =
  "inline-flex size-16 shrink-0 items-center justify-center rounded-2xl border border-base-200 bg-white p-2 shadow-sm transition hover:border-[#1E6B42]/40 hover:shadow-md dark:border-base-700 dark:bg-base-900";
const iconImgClass = "size-10";
---

<BaseLayout
  pageTitle={`Prova de disseny — ${frontmatter.title}`}
  description="Prova visual d'un nou disseny per a les pàgines de parada. No substitueix la pàgina oficial."
>
  <section>
    <div data-text-size-enabled>
      <Wrapper variant="standard" class="pt-24 pb-16 sm:pt-28 lg:pt-32">
        <p class="mb-8 text-center text-sm text-base-500 dark:text-base-400">
          Prova de disseny · no canvia la
          <a
            href={paginaActualHref}
            class="underline decoration-base-400 underline-offset-4 hover:text-base-900 dark:hover:text-white"
          >
            pàgina actual de la parada
          </a>
        </p>

        <div class="mb-4 flex justify-end">
          <ItinerariModalTextSizeControls label="Mida del text de la prova" />
        </div>

        <div class="grid items-start gap-8 lg:grid-cols-[minmax(16rem,38%)_minmax(0,1fr)] lg:gap-12">
          <div>
            <img
              src={icon("parada1-2.webp")}
              alt={`Localització de la parada: ${frontmatter.coordenades}`}
              width="640"
              height="860"
              class="mx-auto w-full max-w-[22rem] lg:max-w-none"
            />
          </div>

          <div class="page-text-content min-w-0">
            <div class="grid gap-x-10 gap-y-8 lg:grid-cols-2">
              <header class="flex items-start gap-6 text-center lg:col-span-2 lg:gap-8 lg:text-left">
                {
                  mapaHref ? (
                    <a
                      href={mapaHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[iconButtonClass, "mt-1"]}
                      aria-label="Obrir el mapa de la parada"
                      title="Mapa"
                    >
                      <img src={icon("triptic.png")} alt="" width="48" height="48" class={iconImgClass} />
                    </a>
                  ) : (
                    <span class:list={[iconButtonClass, "mt-1 opacity-40"]} aria-hidden="true">
                      <img src={icon("triptic.png")} alt="" width="48" height="48" class={iconImgClass} />
                    </span>
                  )
                }
                <div class="min-w-0">
                  <Text
                    tag="p"
                    variant="textSM"
                    class="mb-2 uppercase tracking-[0.18em] text-[#1E6B42]"
                  >
                    Parada
                  </Text>
                  <Text
                    tag="h1"
                    variant="displayXL"
                    class="dark:text-white text-base-900 font-medium tracking-tighter"
                  >
                    {frontmatter.title}
                  </Text>
                </div>
              </header>

              <div class="hidden lg:block" aria-hidden="true"></div>

              <section>
                <Text
                  tag="h2"
                  variant="displayMD"
                  class="dark:text-white text-base-900 font-medium tracking-tighter"
                >
                  Materials
                </Text>
                <ul class="mt-4 flex flex-col gap-3">
                  {
                    frontmatter.materials.map((material) => (
                      <li>
                        <a
                          href={withBase(material.enllaç)}
                          class="text-lg text-accent-700 underline decoration-accent-700/30 underline-offset-4 transition hover:decoration-accent-700 dark:text-accent-400 dark:decoration-accent-400/40"
                        >
                          {material.nom}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </section>

              <section>
                <h2 class="flex items-center gap-3">
                  <span class={iconButtonClass} aria-hidden="true">
                    <img
                      src={icon("llapis3.png")}
                      alt=""
                      width="48"
                      height="48"
                      class={iconImgClass}
                    />
                  </span>
                  <Text
                    tag="span"
                    variant="displayMD"
                    class="dark:text-white text-base-900 font-medium tracking-tighter"
                  >
                    Geologia
                  </Text>
                </h2>
                <p class="mt-4 text-lg leading-relaxed text-base-500 dark:text-base-400 md:text-xl">
                  {frontmatter.geologia?.resum ?? "Contingut de geologia de la parada."}
                </p>
                {
                  frontmatter.geologia && (
                    <p class="mt-5">
                      <button
                        type="button"
                        data-modal-target={
                          hasGeologiaParts ? geologiaIndexModalId : geologiaModalId
                        }
                        class="text-lg text-accent-700 underline decoration-accent-700/30 underline-offset-4 transition hover:decoration-accent-700 dark:text-accent-400 dark:decoration-accent-400/40"
                        aria-haspopup="dialog"
                      >
                        Ampliació
                      </button>
                    </p>
                  )
                }
              </section>

              <section>
                <h2 class="flex items-center gap-3">
                  <span class={iconButtonClass} aria-hidden="true">
                    <img
                      src={icon("llapis3.png")}
                      alt=""
                      width="48"
                      height="48"
                      class={iconImgClass}
                    />
                  </span>
                  {
                    frontmatter.analisiFlora ? (
                      <button
                        type="button"
                        data-modal-target={analisiFloraModalId}
                        class="text-left"
                        aria-haspopup="dialog"
                        aria-label="Obrir geobotànica"
                      >
                        <Text
                          tag="span"
                          variant="displayMD"
                          class="dark:text-white text-base-900 font-medium tracking-tighter"
                        >
                          Geobotànica
                        </Text>
                      </button>
                    ) : (
                      <Text
                        tag="span"
                        variant="displayMD"
                        class="dark:text-white text-base-900 font-medium tracking-tighter"
                      >
                        Geobotànica
                      </Text>
                    )
                  }
                </h2>
                <Text
                  tag="p"
                  variant="textLG"
                  class="mt-4 text-base-500 dark:text-base-400"
                >
                  {frontmatter.analisiFlora?.resum ??
                    frontmatter.geobotanicaText ??
                    "Contingut de geobotànica de la parada."}
                </Text>
              </section>
            </div>
          </div>
        </div>

        {
          frontmatter.fotos && frontmatter.fotos.length > 0 && (
            <div class="mt-16 border-t border-base-200 pt-8 dark:border-base-800">
              <ParadaGallery fotos={frontmatter.fotos} galleryId={`prova-${slug}`} />
            </div>
          )
        }
      </Wrapper>
    </div>

    {
      frontmatter.geologia && hasGeologiaParts && (
        <dialog
          id={geologiaIndexModalId}
          class="itinerari-dada-dialog fixed inset-0 z-[110] m-0 size-full max-h-none max-w-none border-0 bg-base-950/90 p-4 backdrop:bg-transparent open:flex open:items-start open:justify-center overflow-y-auto"
          aria-modal="true"
          aria-labelledby={`${geologiaIndexModalId}-title`}
          data-focus-trap="true"
        >
          <div
            class="itinerari-dada-panel relative my-8 w-full max-w-3xl rounded-lg bg-base-100 p-6 shadow-xl dark:bg-base-900 lg:p-10"
            data-text-size-enabled
            spellcheck="false"
          >
            <ItinerariModalHeaderActions closeClass="itinerari-dada-close rounded-full bg-base-200 px-4 py-2 text-sm text-base-900 hover:bg-base-300 dark:bg-base-800 dark:text-white dark:hover:bg-base-700" />
            <div class="itinerari-modal-text-content">
              <Text
                id={`${geologiaIndexModalId}-title`}
                tag="h2"
                variant="displayMD"
                class="mb-6 pr-52 font-medium tracking-tighter text-base-900 dark:text-white"
              >
                Ampliació de geologia
              </Text>
              <ItinerariDadaIndex
                ariaLabel="Apartats de l'ampliació de geologia"
                modalIdPrefix={`${geologiaModalId}-`}
                items={geologiaParts.map((part, partIndex) => ({
                  label: part.label,
                  modalKey: String(partIndex),
                }))}
              />
            </div>
          </div>
        </dialog>
      )
    }
    {
      frontmatter.geologia &&
        hasGeologiaParts &&
        geologiaParts.map((part, partIndex) => {
          const nextPart = geologiaParts[partIndex + 1];
          return (
            <ItinerariDadaModal
              modalId={`${geologiaModalId}-${partIndex}`}
              label={part.modalLabel ?? `${part.label} — ${frontmatter.title}`}
              intro={part.intro}
              introMedia={part.introMedia}
              sections={part.sections ?? []}
              nextModalId={
                nextPart ? `${geologiaModalId}-${partIndex + 1}` : undefined
              }
              nextLabel={nextPart?.label}
            />
          );
        })
    }
    {
      frontmatter.analisiFlora && (
        <ParadaAnalisiFloraModal
          modalId={analisiFloraModalId}
          data={frontmatter.analisiFlora}
        />
      )
    }
    {
      frontmatter.videoAeri && (
        <ItinerariVideoModal
          modalId={videoAeriModalId}
          label={frontmatter.videoAeri.modalLabel ?? "Vista aèria de la parada"}
          src={frontmatter.videoAeri.publicSrc}
          title={frontmatter.videoAeri.alt}
          sound={frontmatter.videoAeri.ambSo ?? true}
          allowFullscreen
        />
      )
    }
  </section>
</BaseLayout>
