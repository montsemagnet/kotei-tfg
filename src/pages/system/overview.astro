---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { withBase } from "@/utils/withBase";

const itineraris = (await getCollection("itineraris"))
  .filter((entry) => !entry.data.draft && !entry.data.enConstruccio)
  .sort((a, b) => (a.data.ordre ?? 999) - (b.data.ordre ?? 999));

const parades = (await getCollection("parades")).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const materials = (await getCollection("roques")).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const pageData = [
  {
    sectionTitle: "Pàgines principals",
    categories: [
      {
        title: "GeoTransectes UVic",
        links: [
          { url: "/", name: "Inici" },
          { url: "/itineraris", name: "Itineraris" },
          { url: "/termes", name: "Glossari de termes" },
          { url: "/credits", name: "Crèdits i llicències" },
          { url: "/manual", name: "Manual d'incorporació d'itineraris" },
          { url: "/system/overview", name: "Mapa del lloc" },
          { url: "/404", name: "Pàgina no trobada (404)" },
        ],
      },
      {
        title: "Manual d'incorporació",
        links: [
          { url: "/manual", name: "Portada del manual" },
          { url: "/manual/professorat", name: "Dirigit al professorat" },
          { url: "/manual/informatica", name: "Dirigit a informàtica" },
          { url: "/manual/seguretat", name: "Seguretat i protecció de dades" },
          {
            url: "/manual/accessibilitat",
            name: "Revisió d'accessibilitat",
          },
        ],
      },
      {
        title: "Itineraris",
        links: itineraris.map((entry) => ({
          url: `/itineraris/${entry.id}`,
          name: entry.data.title,
        })),
      },
      {
        title: "Parades",
        links: parades.map((entry) => ({
          url: `/parades/${entry.id}`,
          name: `${entry.id} — ${entry.data.title}`,
        })),
      },
      {
        title: "Materials",
        links: materials.map((entry) => ({
          url: `/roques/${entry.id}`,
          name: `${entry.id} — ${entry.data.title}`,
        })),
      },
      {
        title: "Sistema de disseny",
        links: [
          { name: "Colors", url: "/system/colors" },
          { name: "Enllaços", url: "/system/links" },
          { name: "Botons", url: "/system/buttons" },
          { name: "Tipografia", url: "/system/typography" },
        ],
      },
    ],
  },
];
---

<BaseLayout
  pageTitle="Mapa del lloc"
  description="Rutes i pàgines del lloc GeoTransectes UVic."
>
  <section>
    <Wrapper variant="standard" class="py-24">
      <div class="overflow-hidden">
        <Text
          tag="h1"
          variant="displayMD"
          data-aos="fade-up"
          data-aos-duration="1500"
          class="dark:text-white xl:text-6xl tracking-tight font-medium text-black text-balance"
        >
          Mapa del lloc
        </Text>
      </div>
      <Text
        tag="p"
        variant="textBase"
        data-aos="fade-up"
        data-aos-duration="2000"
        class="mt-4 text-base-500 dark:text-base-400 max-w-xl"
      >
        Rutes i pàgines del lloc GeoTransectes UVic.
      </Text>
      {
        pageData.map((section) => (
          <div class="mt-16">
            <Text
              tag="h2"
              variant="textBase"
              class="font-medium text-base-900 dark:text-white uppercase tracking-wide"
            >
              {section.sectionTitle}
            </Text>
            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {section.categories.map((category) => (
                <div>
                  <Text
                    tag="h3"
                    variant="textSM"
                    class="font-medium text-base-700 dark:text-base-300 uppercase tracking-wide"
                  >
                    {category.title}
                  </Text>
                  <ul class="mt-4 space-y-2">
                    {category.links.map((link) => (
                      <li>
                        <Text
                          tag="a"
                          variant="textSM"
                          href={withBase(link.url)}
                          class="text-base-500 hover:text-base-900 dark:hover:text-white duration-300"
                        >
                          {link.name}
                        </Text>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </Wrapper>
  </section>
</BaseLayout>
